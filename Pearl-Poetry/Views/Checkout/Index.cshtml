@model Pearl_Poetry.ViewModels.Checkout.CheckoutViewModel
@using System.Globalization
@using Pearl_Poetry.ViewModels.Checkout
@{
    ViewData["Title"] = "Checkout";
    ViewData["ShowChrome"] = true;

    string Inv(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}

@functions {
    static string M(decimal v) => "৳ " + v.ToString("N2", CultureInfo.InvariantCulture);
}

<div class="shop-container">

    <nav class="breadcrumb">
        <a href="/">Home</a><span>/</span>
        @if (Model.IsBuyNow)
        {
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.BuyNowProductId">Product</a>
        
            <span>/</span>
        }
        else
        {
            <a href="/Cart">Cart</a>
        
            <span>/</span>
        }
        <span>Checkout</span>
    </nav>

    <h1 class="shop-title">Checkout</h1>

    <form asp-controller="Checkout" asp-action="PlaceOrder" method="post" id="ckForm" class="ck-layout"
          data-subtotal="@Inv(Model.Subtotal)"
          data-inside="@Inv(Model.InsideDhakaCharge)"
          data-outside="@Inv(Model.OutsideDhakaCharge)">

        @if (Model.IsBuyNow)
        {
            <input type="hidden" asp-for="BuyNowProductId" />
            <input type="hidden" asp-for="BuyNowVariantId" />
            <input type="hidden" asp-for="BuyNowQuantity" />
        }

        <!-- ================= LEFT: details ================= -->
        <div>
            <div asp-validation-summary="ModelOnly" class="pp-alert"></div>

            <section class="ck-card">
                <h2>Delivery Details</h2>

                <div class="ck-grid">
                    <div class="field">
                        <label asp-for="FullName">Full name <em>*</em></label>
                        <input asp-for="FullName" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Phone">Phone <em>*</em></label>
                        <input asp-for="Phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="01XXXXXXXXX" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Email">Email (optional)</label>
                        <input asp-for="Email" type="email" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="District">District <em>*</em></label>
                        <select asp-for="District">
                            @foreach (var d in CheckoutViewModel.Districts)
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                        <span asp-validation-for="District" class="text-danger"></span>
                    </div>

                    <div class="field full">
                        <label asp-for="Address">Full address <em>*</em></label>
                        <textarea asp-for="Address" rows="2" autocomplete="street-address" placeholder="House, road, area"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="PostalCode">Postal code</label>
                        <input asp-for="PostalCode" inputmode="numeric" autocomplete="postal-code" />
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="DeliveryNote">Delivery note</label>
                        <input asp-for="DeliveryNote" placeholder="Anything we should know?" />
                        <span asp-validation-for="DeliveryNote" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="ck-card">
                <h2>Payment Method</h2>

                <div class="ck-pay-list">
                    <label class="ck-pay">
                        <input type="radio" asp-for="PaymentMethod" value="cod" />
                        <div>
                            <strong>Cash on Delivery</strong>
                            <span>Pay when the parcel reaches you</span>
                        </div>
                    </label>

                    <label class="ck-pay">
                        <input type="radio" asp-for="PaymentMethod" value="bkash" />
                        <div>
                            <strong>bKash</strong>
                            <span>Send money, then enter the transaction ID</span>
                        </div>
                    </label>
                </div>

                <div class="ck-bkash" id="ckBkash" hidden="@(Model.PaymentMethod == "bkash" ? null : "hidden")">
                    <p>
                        Send <b id="ckBkashAmt">@M(Model.Total)</b> to this bKash number
                        (<b>@(string.IsNullOrWhiteSpace(Model.BkashNumber) ? "-" : Model.BkashNumber)</b>) using <b>Send Money</b>,
                        then fill in the details below.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.BkashQrImage))
                    {
                        <img src="@Model.BkashQrImage" alt="bKash QR code"
                             onerror="this.style.display='none'">
                    }

                    <div class="ck-grid">
                        <div class="field">
                            <label asp-for="SenderPhone">Your bKash number <em>*</em></label>
                            <input asp-for="SenderPhone" type="tel" inputmode="tel" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="SenderPhone" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label asp-for="TransactionId">Transaction ID <em>*</em></label>
                            <input asp-for="TransactionId" autocomplete="off" />
                            <span asp-validation-for="TransactionId" class="text-danger"></span>
                        </div>

                        <div class="field full">
                            <label asp-for="SenderName">Sender name</label>
                            <input asp-for="SenderName" />
                            <span asp-validation-for="SenderName" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- ================= RIGHT: summary ================= -->
        <aside class="summary">
            <h2>Your Order</h2>

            @foreach (var item in Model.Items)
            {
                <div class="ck-item">
                    <div class="ck-item-img">
                        <img src="@item.ImagePath" alt="@item.Title"
                             onerror="this.onerror=null;this.src='/images/categories/fashion.jpg';">
                        <b>@item.Quantity</b>
                    </div>

                    <div>
                        <h4>@item.Title</h4>

                        @* color / size are shown ONLY when the variant has a value *@
                        @if (!string.IsNullOrEmpty(item.VariantLabel))
                        {
                            <small>@item.VariantLabel</small>
                        }

                        @if (item.Problem != null)
                        {
                            <small class="cp-problem">@item.Problem</small>
                        }
                    </div>

                    <div class="amount">@M(item.LineTotal)</div>
                </div>
            }

            <div class="summary-line">
                <span>Subtotal</span>
                <span id="ckSubtotal">@M(Model.Subtotal)</span>
            </div>
            <div class="summary-line">
                <span>Delivery</span>
                <span id="ckDelivery">@(Model.DeliveryCharge > 0 ? M(Model.DeliveryCharge) : "Free")</span>
            </div>
            <div class="summary-line total">
                <span>Total</span>
                <span id="ckTotal">@M(Model.Total)</span>
            </div>

            @if (Model.HasProblems)
            {
                <div class="pp-alert">Some items are unavailable. Please update your order before continuing.</div>
            }

            <button type="submit" class="btn btn-primary btn-block" id="ckSubmit" @(Model.CanPlaceOrder ? "" : "disabled")>
                Place Order
            </button>

            @if (Model.IsBuyNow)
            {
                <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.BuyNowProductId" class="link-back">&larr; Back to product</a>
            }
            else
            {
                <a href="/Cart" class="link-back">&larr; Back to cart</a>
            }
        </aside>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
