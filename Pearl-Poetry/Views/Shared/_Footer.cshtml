@using Microsoft.EntityFrameworkCore
@using Pearl_Poetry.Data
@inject EcommerceSystemContext Db
@{
    var s = await Db.Settings.AsNoTracking().FirstOrDefaultAsync();
}

<footer class="footer">
    <div class="footer-container">

        <div class="footer-col brand">
            @if (!string.IsNullOrWhiteSpace(s?.LogoPath))
            {
                <img src="@s!.LogoPath" alt="Logo" class="footer-logo">
            }

            <p class="footer-desc">@s?.ShortDescription</p>

            <div class="footer-contact">
                <p><i class="fa-solid fa-location-dot"></i> @s?.Address</p>
                <p><i class="fa-solid fa-phone"></i> @s?.Phone</p>
                <p><i class="fa-solid fa-envelope"></i> @s?.AdminEmail</p>
            </div>
        </div>

        <div class="footer-col">
            <h3>Quick Links</h3>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/Cart">My Cart</a></li>
                <li><a href="/Wishlist">Wishlist</a></li>
                <li><a href="#">Contact Us</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h3>Customer Service</h3>
            <ul>
                <li><a href="#">FAQ</a></li>
                <li><a href="#">Privacy Policy</a></li>
                <li><a href="#">Terms &amp; Conditions</a></li>
                <li><a href="#">Shipping Policy</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h3>Newsletter</h3>
            <p>Subscribe for latest offers and updates.</p>

            <form class="newsletter-form" onsubmit="return false;">
                <input type="email" placeholder="Enter Email">
                <button type="submit">Subscribe</button>
            </form>

            <div class="social-links">
                <a href="@s?.FacebookUrl" target="_blank" rel="noopener"><i class="fab fa-facebook-f"></i></a>
                <a href="@s?.InstagramUrl" target="_blank" rel="noopener"><i class="fab fa-instagram"></i></a>
                <a href="@s?.YoutubeUrl" target="_blank" rel="noopener"><i class="fab fa-youtube"></i></a>
                <a href="@s?.WhatsappUrl" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i></a>
            </div>
        </div>

    </div>

    <div class="footer-bottom">@s?.CopyrightText</div>
</footer>
