@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Cart / Product Details / Checkout / Success => navbar + footer + shop css
    bool showChrome = ViewData["ShowChrome"] as bool? == true;
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @Site.Name</title>

    @* cart.js / site.js er JSON POST egulo diye anti-forgery token pathay *@
    <meta name="csrf-token" content="@tokens.RequestToken" />
    <meta name="csrf-header" content="@tokens.HeaderName" />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    @if (showChrome)
    {
        @* Home.css = colour variables + navbar + footer, Shop.css = cart/product/checkout *@
        <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/Shop.css" asp-append-version="true" />
    }

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @if (showChrome)
    {
        <partial name="_Navbar" />
    }

    <div class="page-content">
        @RenderBody()
    </div>

    @if (showChrome)
    {
        <partial name="_Footer" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>