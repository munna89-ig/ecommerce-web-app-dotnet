@model Pearl_Poetry.ViewModels.Admin.Settings.SettingsViewModel
@using Pearl_Poetry.ViewModels.Admin.Settings
@{
    ViewData["Title"] = "Settings";

    string? logoUrl = SettingsViewModel.ImageUrl(Model.LogoPath, "settings");
    string? qrUrl = SettingsViewModel.ImageUrl(Model.BkashQrImage, "payments");

    string Tab(string t) => Model.ActiveTab == t ? "tab-active" : "";
    string Panel(string t) => Model.ActiveTab == t ? "" : "hidden";
}

<div class="p-6">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-3xl font-bold">Settings</h1>
            <p class="text-base-content/60">
                Store information, delivery charges, payment and social links.
                @if (Model.UpdatedAt.HasValue)
                {
                    <span class="text-xs">&middot; Last saved @Model.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                }
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4"><span>@TempData["Success"]</span></div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error mb-4">
            <span>Please fix the highlighted fields.</span>
        </div>
    }

    <form asp-area="Admin" asp-controller="Settings" asp-action="Index"
          method="post" enctype="multipart/form-data" novalidate id="settingsForm">

        <input type="hidden" asp-for="ActiveTab" id="activeTab" />

        <!-- Tabs -->
        <div role="tablist" class="tabs tabs-box mb-6 w-fit">
            <button type="button" role="tab" class="tab @Tab("general")" data-tab="general">
                <i class="fa-solid fa-store mr-2"></i> General
            </button>
            <button type="button" role="tab" class="tab @Tab("delivery")" data-tab="delivery">
                <i class="fa-solid fa-truck-fast mr-2"></i> Delivery &amp; Payment
            </button>
            <button type="button" role="tab" class="tab @Tab("contact")" data-tab="contact">
                <i class="fa-solid fa-address-book mr-2"></i> Contact &amp; Social
            </button>
        </div>

        <!-- ================= GENERAL ================= -->
        <div data-panel="general" class="@Panel("general")">
            <div class="card bg-base-100 shadow-sm max-w-4xl">
                <div class="card-body">
                    <h2 class="card-title text-lg">Store information</h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label" asp-for="SiteName"><span class="label-text">Site Name <span class="text-error">*</span></span></label>
                            <input asp-for="SiteName" class="input input-bordered w-full" />
                            <span asp-validation-for="SiteName" class="text-error text-sm"></span>
                        </div>

                        <div class="form-control">
                            <label class="label" asp-for="Currency"><span class="label-text">Currency</span></label>
                            <input asp-for="Currency" class="input input-bordered w-full" placeholder="BDT" maxlength="10" />
                            <span asp-validation-for="Currency" class="text-error text-sm"></span>
                        </div>

                        <div class="form-control md:col-span-2">
                            <label class="label" asp-for="ShortDescription"><span class="label-text">Short Description</span></label>
                            <textarea asp-for="ShortDescription" rows="3" class="textarea textarea-bordered w-full"
                                      placeholder="Shown in the footer"></textarea>
                            <span asp-validation-for="ShortDescription" class="text-error text-sm"></span>
                        </div>

                        <div class="form-control md:col-span-2">
                            <label class="label" asp-for="CopyrightText"><span class="label-text">Copyright Text</span></label>
                            <input asp-for="CopyrightText" class="input input-bordered w-full"
                                   placeholder="© 2026 Pearl Poetry. All rights reserved." />
                            <span asp-validation-for="CopyrightText" class="text-error text-sm"></span>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <h2 class="card-title text-lg">Logo</h2>

                    <div class="flex flex-col sm:flex-row sm:items-center gap-5">
                        <div class="w-40 h-24 rounded-lg bg-base-200 flex items-center justify-center overflow-hidden border border-base-300">
                            <img id="logoPreview" src="@logoUrl" alt="Logo"
                                 class="max-w-full max-h-full object-contain @(logoUrl == null ? "hidden" : "")" />
                            <span id="logoEmpty" class="text-xs text-base-content/50 @(logoUrl != null ? "hidden" : "")">No logo</span>
                        </div>

                        <div class="form-control">
                            <input asp-for="LogoFile" type="file" accept=".jpg,.jpeg,.png,.webp,.gif"
                                   class="file-input file-input-bordered w-full max-w-xs" data-preview="logoPreview" data-empty="logoEmpty" />
                            <span class="text-xs text-base-content/50 mt-1">PNG with transparent background works best &middot; max 5 MB</span>
                            <span asp-validation-for="LogoFile" class="text-error text-sm"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= DELIVERY & PAYMENT ================= -->
        <div data-panel="delivery" class="@Panel("delivery")">
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 max-w-5xl">

                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="card-title text-lg">Delivery charges</h2>
                        <p class="text-sm text-base-content/60 -mt-1">Used on the checkout page.</p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="form-control">
                                <label class="label" asp-for="InsideDhakaCharge"><span class="label-text">Inside Dhaka (৳)</span></label>
                                <input asp-for="InsideDhakaCharge" type="number" step="0.01" min="0" class="input input-bordered w-full" />
                                <span asp-validation-for="InsideDhakaCharge" class="text-error text-sm"></span>
                            </div>

                            <div class="form-control">
                                <label class="label" asp-for="OutsideDhakaCharge"><span class="label-text">Outside Dhaka (৳)</span></label>
                                <input asp-for="OutsideDhakaCharge" type="number" step="0.01" min="0" class="input input-bordered w-full" />
                                <span asp-validation-for="OutsideDhakaCharge" class="text-error text-sm"></span>
                            </div>

                            <div class="form-control">
                                <label class="label" asp-for="ShippingFee"><span class="label-text">Default charge (৳)</span></label>
                                <input asp-for="ShippingFee" type="number" step="0.01" min="0" class="input input-bordered w-full" />
                                <span class="text-xs text-base-content/50 mt-1">Used when the two above are empty.</span>
                                <span asp-validation-for="ShippingFee" class="text-error text-sm"></span>
                            </div>

                            <div class="form-control">
                                <label class="label" asp-for="TaxRate"><span class="label-text">Tax rate (%)</span></label>
                                <input asp-for="TaxRate" type="number" step="0.01" min="0" max="100" class="input input-bordered w-full" />
                                <span class="text-xs text-base-content/50 mt-1">Saved for later - not added at checkout yet.</span>
                                <span asp-validation-for="TaxRate" class="text-error text-sm"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="card-title text-lg">bKash payment</h2>
                        <p class="text-sm text-base-content/60 -mt-1">Customers see this number and QR code at checkout.</p>

                        <div class="form-control">
                            <label class="label" asp-for="BkashNumber"><span class="label-text">bKash number</span></label>
                            <input asp-for="BkashNumber" class="input input-bordered w-full" placeholder="01712345678" />
                            <span asp-validation-for="BkashNumber" class="text-error text-sm"></span>
                        </div>

                        <div class="flex flex-col sm:flex-row sm:items-center gap-5 mt-3">
                            <div class="w-32 h-32 rounded-lg bg-base-200 flex items-center justify-center overflow-hidden border border-base-300">
                                <img id="qrPreview" src="@qrUrl" alt="bKash QR"
                                     class="max-w-full max-h-full object-contain @(qrUrl == null ? "hidden" : "")" />
                                <span id="qrEmpty" class="text-xs text-base-content/50 @(qrUrl != null ? "hidden" : "")">No QR</span>
                            </div>

                            <div class="form-control">
                                <label class="label" asp-for="BkashQrFile"><span class="label-text">QR code image</span></label>
                                <input asp-for="BkashQrFile" type="file" accept=".jpg,.jpeg,.png,.webp"
                                       class="file-input file-input-bordered w-full max-w-xs" data-preview="qrPreview" data-empty="qrEmpty" />
                                <span asp-validation-for="BkashQrFile" class="text-error text-sm"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= CONTACT & SOCIAL ================= -->
        <div data-panel="contact" class="@Panel("contact")">
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 max-w-5xl">

                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="card-title text-lg">Contact</h2>
                        <p class="text-sm text-base-content/60 -mt-1">Shown in the footer.</p>

                        <div class="form-control">
                            <label class="label" asp-for="AdminEmail"><span class="label-text">Email</span></label>
                            <input asp-for="AdminEmail" type="email" class="input input-bordered w-full" placeholder="hello@pearlpoetry.com" />
                            <span asp-validation-for="AdminEmail" class="text-error text-sm"></span>
                        </div>

                        <div class="form-control">
                            <label class="label" asp-for="Phone"><span class="label-text">Phone</span></label>
                            <input asp-for="Phone" class="input input-bordered w-full" placeholder="+880 1712-345678" />
                            <span asp-validation-for="Phone" class="text-error text-sm"></span>
                        </div>

                        <div class="form-control">
                            <label class="label" asp-for="Address"><span class="label-text">Address</span></label>
                            <textarea asp-for="Address" rows="2" class="textarea textarea-bordered w-full"></textarea>
                            <span asp-validation-for="Address" class="text-error text-sm"></span>
                        </div>
                    </div>
                </div>

                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="card-title text-lg">Social links</h2>
                        <p class="text-sm text-base-content/60 -mt-1">Leave empty to hide. Full links starting with https://</p>

                        @{
                            var socials = new (string Field, string Icon, string Placeholder)[]
                            {
                                                (nameof(Model.FacebookUrl), "fa-brands fa-facebook-f", "https://facebook.com/pearlpoetry"),
                                                (nameof(Model.InstagramUrl), "fa-brands fa-instagram", "https://instagram.com/pearlpoetry"),
                                                (nameof(Model.YoutubeUrl), "fa-brands fa-youtube", "https://youtube.com/@pearlpoetry"),
                                                (nameof(Model.WhatsappUrl), "fa-brands fa-whatsapp", "https://wa.me/8801712345678"),
                                                (nameof(Model.MessengerLink), "fa-brands fa-facebook-messenger", "https://m.me/pearlpoetry")
                            };
                        }

                        @foreach (var s in socials)
                        {
                            var value = ViewData.Model.GetType().GetProperty(s.Field)!.GetValue(Model) as string;

                            <div class="form-control">
                                <label class="input input-bordered flex items-center gap-3 w-full">
                                    <i class="@s.Icon w-4 text-base-content/60"></i>
                                    <input type="url" name="@s.Field" id="@s.Field" value="@value"
                                           class="grow" placeholder="@s.Placeholder" />
                                </label>
                                @Html.ValidationMessage(s.Field, new { @class = "text-error text-sm" })
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Save bar -->
        <div class="sticky bottom-0 mt-6 py-4 bg-base-200/90 backdrop-blur flex gap-3 max-w-5xl">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i> Save Settings
            </button>
            <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="btn btn-ghost">Discard changes</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const hidden = document.getElementById('activeTab');

            function show(tab) {
                document.querySelectorAll('[data-panel]').forEach(p =>
                    p.classList.toggle('hidden', p.dataset.panel !== tab));
                document.querySelectorAll('[data-tab]').forEach(b =>
                    b.classList.toggle('tab-active', b.dataset.tab === tab));
                hidden.value = tab;
            }

            document.querySelectorAll('[data-tab]').forEach(btn =>
                btn.addEventListener('click', () => show(btn.dataset.tab)));

            // after a failed save: open the tab that has the first error
            const firstError = document.querySelector('.field-validation-error, .input-validation-error');
            if (firstError) {
                const panel = firstError.closest('[data-panel]');
                if (panel) show(panel.dataset.panel);
            }

            // image preview before upload
            document.querySelectorAll('input[type=file][data-preview]').forEach(input => {
                input.addEventListener('change', () => {
                    const file = input.files && input.files[0];
                    if (!file) return;

                    const img = document.getElementById(input.dataset.preview);
                    const empty = document.getElementById(input.dataset.empty);

                    img.src = URL.createObjectURL(file);
                    img.classList.remove('hidden');
                    if (empty) empty.classList.add('hidden');
                });
            });
        })();
    </script>
}