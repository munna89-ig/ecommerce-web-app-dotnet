@model Pearl_Poetry.ViewModels.Admin.Analytics.AnalyticsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Analytics";

    string Money(decimal v) => "৳ " + v.ToString("N0");

    string Label(string s) => s.ToLower() switch
    {
        "bkash" => "bKash",
        "cod" => "Cash on Delivery",
        "card" => "Card",
        _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(s.Replace("_", " "))
    };

    var ranges = new[] { ("7d", "7 days"), ("30d", "30 days"), ("90d", "90 days"), ("12m", "12 months") };

    var chartJson = JsonSerializer.Serialize(new
    {
        labels = Model.Series.Select(p => p.Label),
        revenue = Model.Series.Select(p => p.Revenue),
        orders = Model.Series.Select(p => p.Orders)
    });

    decimal maxStatus = Model.StatusBreakdown.Any() ? Model.StatusBreakdown.Max(b => b.Count) : 1;
    decimal paySum = Model.PaymentMethods.Sum(b => b.Amount);
    decimal maxProduct = Model.TopProducts.Any() ? Model.TopProducts.Max(p => p.Revenue) : 1;
    decimal maxCategory = Model.TopCategories.Any() ? Model.TopCategories.Max(c => c.Amount) : 1;
}

<div class="p-6 space-y-6">

    <!-- Header + range -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold">Analytics</h1>
            <p class="text-base-content/60">
                @Model.RangeLabel &middot; @Model.From.ToString("dd MMM yyyy") – @Model.To.ToString("dd MMM yyyy")
                <span class="text-xs">(compared with the previous @Model.RangeLabel.Replace("Last ", ""))</span>
            </p>
        </div>

        <div class="join">
            @foreach (var (key, text) in ranges)
            {
                <a asp-action="Index" asp-route-range="@key"
                   class="join-item btn btn-sm @(Model.Range == key ? "btn-primary" : "")">@text</a>
            }
        </div>
    </div>

    <!-- KPI tiles -->
    <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
        @{
            var kpis = new (string Title, Pearl_Poetry.ViewModels.Admin.Analytics.AnalyticsKpi Kpi, bool IsMoney)[]
            {
                ("Revenue", Model.Revenue, true),
                ("Orders", Model.Orders, false),
                ("Avg. order value", Model.AverageOrder, true),
                ("Items sold", Model.ItemsSold, false),
                ("New customers", Model.NewCustomers, false),
                ("Cancelled orders", Model.Cancelled, false)
            };
        }

        @foreach (var k in kpis)
        {
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4">
                    <p class="text-sm text-base-content/60">@k.Title</p>
                    <p class="text-2xl font-bold">
                        @(k.IsMoney? Money(k.Kpi.Value) : k.Kpi.Value.ToString("N0"))
                    </p>

                    @if (k.Kpi.ChangePercent.HasValue)
                    {
                        var up = k.Kpi.ChangePercent > 0;
                        <p class="text-xs font-medium @(k.Kpi.ChangePercent == 0 ? "text-base-content/50" : k.Kpi.IsGood ? "text-success" : "text-error")">
                            @(k.Kpi.ChangePercent == 0 ? "–" : up ? "▲" : "▼")
                            @Math.Abs(k.Kpi.ChangePercent.Value)%
                            <span class="text-base-content/50 font-normal">vs previous</span>
                        </p>
                    }
                    else
                    {
                        <p class="text-xs text-base-content/40">No earlier data</p>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Revenue over time -->
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="flex items-center justify-between">
                <h2 class="card-title text-lg">Revenue over time</h2>
                <span class="text-sm text-base-content/60">@(Model.Monthly ? "per month" : "per day")</span>
            </div>

            @if (!Model.HasData)
            {
                <div class="text-center text-base-content/60 py-16">
                    No orders in this period.
                </div>
            }
            else
            {
                <div class="relative h-72">
                    <canvas id="revenueChart" aria-label="Revenue over time" role="img"></canvas>
                </div>

                <details class="mt-2">
                    <summary class="cursor-pointer text-sm text-base-content/60">View as table</summary>
                    <div class="overflow-x-auto max-h-72 mt-2">
                        <table class="table table-xs">
                            <thead><tr><th>@(Model.Monthly ? "Month" : "Date")</th><th class="text-right">Orders</th><th class="text-right">Revenue</th></tr></thead>
                            <tbody>
                                @foreach (var p in Model.Series)
                                {
                                    <tr>
                                        <td>@p.Label</td>
                                        <td class="text-right">@p.Orders</td>
                                        <td class="text-right">@Money(p.Revenue)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">

        <!-- Orders by status -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-lg">Orders by status</h2>

                @if (!Model.StatusBreakdown.Any())
                {
                    <p class="text-base-content/60 py-6">No orders in this period.</p>
                }
                else
                {
                    <div class="space-y-3 mt-2">
                        @foreach (var s in Model.StatusBreakdown)
                        {
                            var w = Math.Max(2, (int)(s.Count / maxStatus * 100));
                            <div title="@Label(s.Label): @s.Count orders · @Money(s.Amount)">
                                <div class="flex justify-between text-sm mb-1">
                                    <span>@Label(s.Label)</span>
                                    <span class="font-semibold">@s.Count</span>
                                </div>
                                <div class="h-2.5 rounded-full bg-base-200">
                                    <div class="h-2.5 rounded-full bg-primary" style="width:@w%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Payment methods -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-lg">Payment methods</h2>
                <p class="text-xs text-base-content/50 -mt-1">Share of sales (cancelled orders excluded)</p>

                @if (!Model.PaymentMethods.Any())
                {
                    <p class="text-base-content/60 py-6">No sales in this period.</p>
                }
                else
                {
                    <div class="space-y-4 mt-2">
                        @foreach (var p in Model.PaymentMethods)
                        {
                            var pct = paySum == 0 ? 0 : Math.Round(p.Amount / paySum * 100, 1);
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span>@Label(p.Label) <span class="text-base-content/50">· @p.Count orders</span></span>
                                    <span class="font-semibold">@Money(p.Amount) <span class="text-base-content/50 font-normal">(@pct%)</span></span>
                                </div>
                                <div class="h-2.5 rounded-full bg-base-200">
                                    <div class="h-2.5 rounded-full bg-primary" style="width:@(Math.Max(2, (int)pct))%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Top products -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-lg">Top products</h2>

                @if (!Model.TopProducts.Any())
                {
                    <p class="text-base-content/60 py-6">No products sold in this period.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="table table-sm">
                            <thead>
                                <tr><th>#</th><th>Product</th><th class="text-right">Sold</th><th class="w-2/5">Revenue</th></tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopProducts.Count; i++)
                                {
                                    var p = Model.TopProducts[i];
                                    var w = Math.Max(2, (int)(p.Revenue / maxProduct * 100));
                                    <tr>
                                        <td class="text-base-content/50">@(i + 1)</td>
                                        <td>
                                            @if (p.ProductId.HasValue)
                                            {
                                                <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId"
                                                   class="link link-hover">@p.Title</a>
                                            }
                                            else
                                            {
                                                @p.Title
                                            }
                                        </td>
                                        <td class="text-right">@p.Quantity</td>
                                        <td>
                                            <div class="flex items-center gap-2">
                                                <div class="h-2 rounded-full bg-primary" style="width:@w%"></div>
                                                <span class="text-sm whitespace-nowrap">@Money(p.Revenue)</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Sales by category -->
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-lg">Sales by category</h2>

                @if (!Model.TopCategories.Any())
                {
                    <p class="text-base-content/60 py-6">No sales in this period.</p>
                }
                else
                {
                    <div class="space-y-3 mt-2">
                        @foreach (var c in Model.TopCategories)
                        {
                            var w = Math.Max(2, (int)(c.Amount / maxCategory * 100));
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span>@c.Label <span class="text-base-content/50">· @c.Count items</span></span>
                                    <span class="font-semibold">@Money(c.Amount)</span>
                                </div>
                                <div class="h-2.5 rounded-full bg-base-200">
                                    <div class="h-2.5 rounded-full bg-primary" style="width:@w%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Top customers -->
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="card-title text-lg">Top customers</h2>
            <p class="text-xs text-base-content/50 -mt-1">Registered customers only</p>

            @if (!Model.TopCustomers.Any())
            {
                <p class="text-base-content/60 py-6">No customer orders in this period.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="table table-sm">
                        <thead>
                            <tr><th>#</th><th>Customer</th><th class="text-right">Orders</th><th class="text-right">Spent</th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.TopCustomers.Count; i++)
                            {
                                var c = Model.TopCustomers[i];
                                <tr>
                                    <td class="text-base-content/50">@(i + 1)</td>
                                    <td class="font-medium">@c.Name</td>
                                    <td class="text-right">@c.Orders</td>
                                    <td class="text-right font-semibold">@Money(c.Spent)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.HasData)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
        <script type="application/json" id="analyticsData">@Html.Raw(chartJson)</script>
        <script>
            (function () {
                const data = JSON.parse(document.getElementById('analyticsData').textContent);
                const canvas = document.getElementById('revenueChart');
                if (!canvas || !window.Chart) return;

                const style = getComputedStyle(document.body);
                const ink = style.color;                       // theme text colour
                const accent = '#c8553d';                      // Pearl Poetry accent
                const grid = 'rgba(128,128,128,.15)';

                const money = (v) => '৳ ' + Number(v).toLocaleString('en-US', { maximumFractionDigits: 0 });
                const compact = (v) => v >= 100000 ? (v / 100000).toFixed(1) + 'L'
                                     : v >= 1000 ? (v / 1000).toFixed(0) + 'k' : v;

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: data.labels,
                        datasets: [{
                            label: 'Revenue',
                            data: data.revenue,
                            borderColor: accent,
                            backgroundColor: 'rgba(200, 85, 61, .12)',
                            fill: true,
                            tension: .3,
                            borderWidth: 2,
                            pointRadius: data.labels.length > 31 ? 0 : 3,
                            pointHoverRadius: 6,
                            pointBackgroundColor: accent
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: (c) => ' Revenue: ' + money(c.parsed.y),
                                    afterLabel: (c) => ' Orders: ' + data.orders[c.dataIndex]
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { color: ink, autoSkip: true, maxTicksLimit: 10, maxRotation: 0 }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: grid },
                                border: { display: false },
                                ticks: { color: ink, callback: (v) => '৳' + compact(v) }
                            }
                        }
                    }
                });
            })();
        </script>
    }
}