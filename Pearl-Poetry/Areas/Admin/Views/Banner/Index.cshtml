@model List<Pearl_Poetry.Data.Entities.Banner>
@using Pearl_Poetry.ViewModels.Admin.Banners
@{
    ViewData["Title"] = "Banners";
    DateTime today = ViewBag.Today ?? DateTime.Today;

    (string Css, string Text) Status(Pearl_Poetry.Data.Entities.Banner b)
    {
        if (b.IsActive != true) return ("badge-ghost", "Hidden");
        if (b.StartDate.HasValue && b.StartDate.Value.Date > today) return ("badge-info", "Scheduled");
        if (b.EndDate.HasValue && b.EndDate.Value.Date < today) return ("badge-warning", "Expired");
        return ("badge-success", "Live");
    }
}

<div class="p-6">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-3xl font-bold">Banners</h1>
            <p class="text-base-content/60">Slides shown at the top of the home page. Lower order shows first.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add Banner
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4"><span>@TempData["Success"]</span></div>
    }

    @if (!Model.Any())
    {
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body items-center text-center py-16">
                <i class="fa-regular fa-images text-5xl text-base-content/30"></i>
                <h2 class="text-xl font-semibold mt-3">No banners yet</h2>
                <p class="text-base-content/60">The home page shows the 3 default images until you add one.</p>
                <a asp-action="Create" class="btn btn-primary mt-4">Add your first banner</a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            @foreach (var b in Model)
            {
                var status = Status(b);

                <div class="card bg-base-100 shadow-sm overflow-hidden">
                    <div style="height:180px;background:#f4ede6;position:relative;">
                        <img src="@BannerFormViewModel.ImageUrl(b.ImagePath)" alt="@b.Title"
                             style="width:100%;height:100%;object-fit:contain;display:block;"
                             onerror="this.onerror=null;this.src='/images/categories/fashion.jpg';" />
                        <span class="badge @status.Css" style="position:absolute;top:12px;left:12px;">@status.Text</span>
                        <span class="badge badge-neutral" style="position:absolute;top:12px;right:12px;">#@(b.SortOrder ?? 0)</span>
                    </div>

                    <div class="card-body p-5">
                        <h2 class="font-semibold text-lg">@(string.IsNullOrWhiteSpace(b.Title) ? "Untitled banner" : b.Title)</h2>

                        <div class="text-sm text-base-content/70 space-y-1">
                            <div>
                                <i class="fa-solid fa-link w-4"></i>
                                @if (string.IsNullOrWhiteSpace(b.LinkUrl))
                                {
                                    <span class="text-base-content/50">No link</span>
                                }
                                else
                                {
                                    <a href="@b.LinkUrl" target="_blank" class="link link-hover">@b.LinkUrl</a>
                                }
                            </div>
                            <div>
                                <i class="fa-regular fa-calendar w-4"></i>
                                @(b.StartDate?.ToString("dd MMM yyyy") ?? "Always")
                                &rarr;
                                @(b.EndDate?.ToString("dd MMM yyyy") ?? "No end")
                            </div>
                        </div>

                        <div class="card-actions justify-end mt-3">
                            <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline">
                                <i class="fa-solid fa-pen"></i> Edit
                            </a>

                            <form asp-action="ToggleActive" asp-route-id="@b.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-ghost">
                                    @if (b.IsActive == true)
                                    {
                                        <i class="fa-regular fa-eye-slash"></i> <span>Hide</span>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-eye"></i> <span>Show</span>
                                    }
                                </button>
                            </form>

                            <form asp-action="Delete" asp-route-id="@b.Id" method="post" style="display:inline;"
                                  onsubmit="return confirm('Delete this banner? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-error btn-outline">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>