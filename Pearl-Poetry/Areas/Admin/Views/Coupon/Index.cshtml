@model List<Pearl_Poetry.Data.Entities.Coupon>

@{
    ViewData["Title"] = "Coupons";
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/coupon.css" asp-append-version="true" />

<div class="min-h-screen bg-base-200 p-6">

    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-3xl font-bold text-base-content">Coupons</h1>
            <p class="text-base-content/60 mt-1">Create and manage discount coupons.</p>
        </div>
        <a asp-area="Admin" asp-controller="Coupon" asp-action="Create" class="btn btn-primary">
            + New Coupon
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error mb-4">@TempData["Error"]</div>
    }

    <form method="get" asp-area="Admin" asp-controller="Coupon" asp-action="Index" class="card bg-base-100 shadow-md mb-6">
        <div class="card-body flex flex-wrap gap-4 items-end">
            <div class="form-control flex-1 min-w-[200px]">
                <label class="label"><span class="label-text">Search by code</span></label>
                <input id="couponSearchLive" type="text" name="search" value="@ViewBag.Search" placeholder="e.g. WELCOME10" class="input input-bordered w-full" />
            </div>
            <div class="form-control min-w-[160px]">
                <label class="label"><span class="label-text">Status</span></label>
                <select name="isActive" class="select select-bordered">
                    <option value="">All</option>
                    <option value="true" selected="@(ViewBag.IsActive == true)">Active</option>
                    <option value="false" selected="@(ViewBag.IsActive == false)">Inactive</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-area="Admin" asp-controller="Coupon" asp-action="Index" class="btn btn-ghost">Clear</a>
        </div>
    </form>

    <div class="card bg-base-100 shadow-md">
        <div class="card-body overflow-x-auto">
            <table class="table coupon-table" id="couponsTable">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Discount</th>
                        <th>Min. Order</th>
                        <th>Usage</th>
                        <th>Restricted To</th>
                        <th>Valid Period</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-base-content/60 py-8">No coupons found.</td>
                        </tr>
                    }
                    @foreach (var coupon in Model)
                    {
                        <tr>
                            <td class="font-mono font-semibold coupon-code-cell">@coupon.Code</td>
                            <td>
                                @if (coupon.DiscountType == "percentage")
                                {
                                    @(coupon.DiscountValue + "%")
                                }
                                else
                                {
                                    @("৳" + coupon.DiscountValue)
                                }
                            </td>
                            <td>@(coupon.MinOrderAmount.HasValue ? "৳" + coupon.MinOrderAmount : "-")</td>
                            <td>@(coupon.UsedCount ?? 0) / @(coupon.MaxUsage?.ToString() ?? "∞")</td>
                            <td>
                                @if (coupon.User != null)
                                {
                                    <span class="badge badge-info">@coupon.User.Name</span>
                                }
                                else if (coupon.MinCustomerSpend > 0)
                                {
                                    <span class="badge badge-warning">Shopped ৳@(coupon.MinCustomerSpend.Value.ToString("N0"))+</span>
                                }
                                else
                                {
                                    <span class="text-base-content/50">Everyone</span>
                                }
                            </td>
                            <td class="text-sm">
                                @(coupon.StartDate?.ToString("dd MMM yyyy") ?? "-") &rarr; @(coupon.ExpiryDate?.ToString("dd MMM yyyy") ?? "No expiry")
                            </td>
                            <td>
                                @if (coupon.IsActive == true)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-ghost">Inactive</span>
                                }
                            </td>
                            <td class="flex gap-2">
                                <a asp-area="Admin" asp-controller="Coupon" asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline">Edit</a>
                                <form method="post" asp-area="Admin" asp-controller="Coupon" asp-action="Delete" asp-route-id="@coupon.Id">
                                    <button type="submit" class="btn btn-sm btn-error btn-outline btn-deactivate-coupon" data-code="@coupon.Code">Deactivate</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/js/coupon.js" asp-append-version="true"></script>
