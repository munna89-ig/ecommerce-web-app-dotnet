@model Pearl_Poetry.ViewModels.Coupon.CouponEditViewModel
@using Pearl_Poetry.Data.Entities

@{
    ViewData["Title"] = "Edit Coupon";
    var customers = ViewBag.Customers as List<User> ?? new List<User>();
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/coupon.css" asp-append-version="true" />

<div class="min-h-screen bg-base-200 p-6">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-base-content">Edit Coupon</h1>
        <p class="text-base-content/60 mt-1">Used @Model.UsedCount time(s) so far.</p>
    </div>

    <div class="card bg-base-100 shadow-md max-w-3xl">
        <div class="card-body">
            <form method="post" asp-area="Admin" asp-controller="Coupon" asp-action="Edit" asp-route-id="@Model.Id" id="couponForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UsedCount" />

                <div asp-validation-summary="All" class="alert alert-error mb-4"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-control">
                        <label class="label" asp-for="Code"><span class="label-text">Coupon Code</span></label>
                        <input asp-for="Code" class="input input-bordered" />
                        <span asp-validation-for="Code" class="text-error text-sm"></span>
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="DiscountType"><span class="label-text">Discount Type</span></label>
                        <select asp-for="DiscountType" class="select select-bordered">
                            <option value="percentage">Percentage (%)</option>
                            <option value="fixed">Fixed Amount (৳)</option>
                        </select>
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="DiscountValue"><span class="label-text">Discount Value</span></label>
                        <input asp-for="DiscountValue" type="number" step="0.01" class="input input-bordered" />
                        <span asp-validation-for="DiscountValue" class="text-error text-sm"></span>
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="MinOrderAmount"><span class="label-text">Minimum Order Amount (৳)</span></label>
                        <input asp-for="MinOrderAmount" type="number" step="0.01" class="input input-bordered" placeholder="Optional" />
                    </div>

                    <div class="form-control coupon-max-discount-field" id="maxDiscountField">
                        <label class="label" asp-for="MaxDiscountAmount"><span class="label-text">Maximum Discount Amount (৳)</span></label>
                        <input asp-for="MaxDiscountAmount" type="number" step="0.01" class="input input-bordered" placeholder="Optional, for % coupons" />
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="MaxUsage"><span class="label-text">Total Usage Limit</span></label>
                        <input asp-for="MaxUsage" type="number" class="input input-bordered" placeholder="Leave empty for unlimited" />
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="MaxUsagePerUser"><span class="label-text">Usage Limit Per User</span></label>
                        <input asp-for="MaxUsagePerUser" type="number" class="input input-bordered" placeholder="e.g. 1" />
                    </div>

                    <div class="form-control">
                        <label class="label"><span class="label-text">Active</span></label>
                        <label class="label cursor-pointer justify-start gap-3">
                            <input asp-for="IsActive" type="checkbox" class="toggle toggle-primary" />
                            <span class="label-text">Enabled</span>
                        </label>
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="StartDate"><span class="label-text">Start Date</span></label>
                        <input asp-for="StartDate" type="date" class="input input-bordered" />
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="ExpiryDate"><span class="label-text">Expiry Date</span></label>
                        <input asp-for="ExpiryDate" type="date" class="input input-bordered" />
                        <span class="text-base-content/50 text-xs mt-1">Leave empty for a coupon that never expires.</span>
                    </div>
                </div>

                <div class="divider coupon-form-section-title">Restrictions</div>

                <!-- ============ WHO CAN USE THIS COUPON ============ -->
                <div class="form-control mb-4">
                    <label class="label"><span class="label-text font-medium">Who can use this coupon?</span></label>

                    <div class="coupon-audience">
                        <label class="coupon-audience-option">
                            <input type="radio" asp-for="Audience" value="everyone" class="radio radio-primary radio-sm" />
                            <span>
                                <b>Everyone</b>
                                <small>Any customer can use this coupon.</small>
                            </span>
                        </label>

                        <label class="coupon-audience-option">
                            <input type="radio" asp-for="Audience" value="customer" class="radio radio-primary radio-sm" />
                            <span>
                                <b>Specific customer</b>
                                <small>Only the customer you select.</small>
                            </span>
                        </label>

                        <label class="coupon-audience-option">
                            <input type="radio" asp-for="Audience" value="spend" class="radio radio-primary radio-sm" />
                            <span>
                                <b>Loyal customers</b>
                                <small>Customers who have shopped above a total amount.</small>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- shown only for "Specific customer" (asp-for keeps the saved customer selected) -->
                <div class="form-control mb-4" data-audience-field="customer">
                    <label class="label" asp-for="UserId"><span class="label-text">Customer</span></label>
                    <select asp-for="UserId" class="select select-bordered">
                        <option value="">— Select a customer —</option>
                        @foreach (var user in customers)
                        {
                            <option value="@user.Id">@user.Name (@user.Email)</option>
                        }
                    </select>
                </div>

                <!-- shown only for "Loyal customers" -->
                <div class="form-control mb-4" data-audience-field="spend">
                    <label class="label" asp-for="MinCustomerSpend"><span class="label-text">Minimum total purchase (৳)</span></label>
                    <input asp-for="MinCustomerSpend" type="number" step="0.01" min="1"
                           class="input input-bordered" placeholder="e.g. 10000" />
                    <span class="text-base-content/50 text-xs mt-1">
                        Only customers whose <b>delivered</b> orders add up to this amount or more can use the coupon.
                    </span>
                    <span asp-validation-for="MinCustomerSpend" class="text-error text-sm"></span>
                </div>

                <!-- ============ CATEGORIES ============ -->
                <div class="form-control mb-6">
                    <label class="label"><span class="label-text">Applicable Categories</span></label>
                    <div class="flex flex-wrap gap-4 p-3 border border-base-300 rounded-lg coupon-category-list">
                        @if (!categories.Any())
                        {
                            <span class="text-base-content/50 text-sm">No categories found.</span>
                        }
                        @foreach (var category in categories)
                        {
                            <label class="label cursor-pointer gap-2">
                                <input type="checkbox" name="CategoryIds" value="@category.Id" class="checkbox checkbox-sm"
                                       checked="@Model.CategoryIds.Contains(category.Id)" />
                                <span class="label-text">@category.Name</span>
                            </label>
                        }
                    </div>
                    <span class="text-base-content/50 text-xs mt-1">Leave all unchecked to apply on every category.</span>
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-area="Admin" asp-controller="Coupon" asp-action="Index" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/coupon.js" asp-append-version="true"></script>