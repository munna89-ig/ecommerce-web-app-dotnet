@model Pearl_Poetry.Data.Entities.User
@{
    ViewData["Title"] = "Delete User";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="usr-page">

    <a asp-action="Index" class="usr-back"><i class="fa-solid fa-arrow-left"></i> Back to users</a>

    <div class="usr-header">
        <div>
            <h1>Delete User</h1>
        </div>
    </div>

    <div class="usr-card" style="max-width:620px">
        <div class="usr-profile">
            <div class="usr-avatar usr-avatar-lg">@Model.Name.Substring(0, 1).ToUpper()</div>
            <div>
                <h2>@Model.Name</h2>
                <p class="usr-email" style="font-size:14px">@Model.Email</p>
                <span class="usr-badge usr-badge-customer" style="margin-top:8px">@Model.Role</span>
            </div>
        </div>

        <div class="usr-warning">
            <div class="usr-alert usr-alert-error">
                <i class="fa-solid fa-triangle-exclamation"></i>
                This cannot be undone.
            </div>
            <p>
                If this user already has orders, payments or reviews, the database may block the delete.
                In that case, <strong>deactivate</strong> the account instead so their history stays intact.
            </p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="usr-form-foot" style="border:none; padding:0">
                @Html.AntiForgeryToken()
                <a asp-action="Details" asp-route-id="@Model.Id" class="usr-btn usr-btn-ghost">Cancel</a>
                <button type="submit" class="usr-btn usr-btn-danger">
                    <i class="fa-solid fa-trash"></i> Yes, delete
                </button>
            </form>
        </div>
    </div>
</div>