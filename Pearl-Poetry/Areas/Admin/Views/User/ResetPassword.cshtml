@model Pearl_Poetry.Models.ViewModels.Admin.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="usr-page">

    <a asp-action="Details" asp-route-id="@Model.UserId" class="usr-back"><i class="fa-solid fa-arrow-left"></i> Back to user</a>

    <div class="usr-header">
        <div>
            <h1>Reset Password</h1>
            <p>@Model.UserName · @Model.Email</p>
        </div>
    </div>

    <div class="usr-card usr-form-card" style="max-width:520px">
        <form asp-action="ResetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserName" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="usr-alert usr-alert-error usr-validation-summary"></div>

            <div class="usr-field">
                <label asp-for="NewPassword">New Password <span>*</span></label>
                <input asp-for="NewPassword" placeholder="Min. 6 characters" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>

            <div class="usr-field">
                <label asp-for="ConfirmPassword">Confirm Password <span>*</span></label>
                <input asp-for="ConfirmPassword" placeholder="Repeat password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="usr-form-foot">
                <a asp-action="Details" asp-route-id="@Model.UserId" class="usr-btn usr-btn-ghost">Cancel</a>
                <button type="submit" class="usr-btn usr-btn-primary">
                    <i class="fa-solid fa-key"></i> Reset Password
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}