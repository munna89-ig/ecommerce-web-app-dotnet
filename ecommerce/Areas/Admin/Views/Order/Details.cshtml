@model Pearl_Poetry.ViewModels.Order.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";

    string statusClass =
        Model.Status switch
        {
            "pending" => "badge-warning",
            "confirmed" => "badge-info",
            "processing" => "badge-primary",
            "shipped" => "badge-secondary",
            "delivered" => "badge-success",
            "cancelled" => "badge-error",
            "returned" => "badge-warning",
            "refunded" => "badge-neutral",
            _ => "badge-ghost"
        };
}
<div class="flex flex-wrap gap-2">

    <a asp-area="Admin"
       asp-controller="Order"
       asp-action="Invoice"
       asp-route-id="@Model.Id"
       target="_blank"
       class="btn btn-primary">
        🖨️ Print / Invoice
    </a>

    <a asp-area="Admin"
       asp-controller="Order"
       asp-action="Index"
       class="btn btn-ghost">
        Back to Orders
    </a>

</div>

<div class="p-6">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

        <div>

            <div class="flex items-center gap-3">

                <h1 class="text-3xl font-bold">
                    @Model.OrderNumber
                </h1>

                <span class="badge @statusClass">
                    @Model.Status.Replace("_", " ")
                </span>

            </div>

            <p class="text-base-content/60 mt-1">
                Placed on @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
            </p>

        </div>


        <a asp-action="Index"
           class="btn btn-outline">

            ← Back to Orders

        </a>

    </div>


    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-6">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error mb-6">
            @TempData["Error"]
        </div>
    }


    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">


        <!-- ===================================================== -->
        <!-- LEFT / MAIN -->
        <!-- ===================================================== -->

        <div class="xl:col-span-2 space-y-6">


            <!-- ORDER ITEMS -->

            <div class="card bg-base-100 shadow-sm">

                <div class="card-body">

                    <h2 class="card-title mb-4">
                        Order Items
                    </h2>


                    <div class="overflow-x-auto">

                        <table class="table">

                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Variant</th>
                                    <th>Price</th>
                                    <th>Qty</th>
                                    <th>Total</th>
                                </tr>
                            </thead>


                            <tbody>

                                @foreach (var item in Model.Items)
                                {
                                    <tr>

                                        <td>
                                            <div class="font-medium">
                                                @item.ProductTitle
                                            </div>
                                        </td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.VariantLabel))
                                            {
                                                <span class="text-sm">
                                                    @item.VariantLabel
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-base-content/40">
                                                    —
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            ৳@item.Price.ToString("N2")
                                        </td>

                                        <td>
                                            @item.Quantity
                                        </td>

                                        <td class="font-semibold">
                                            ৳@item.LineTotal.ToString("N2")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- PRICE SUMMARY -->

            <div class="card bg-base-100 shadow-sm">

                <div class="card-body">

                    <h2 class="card-title">
                        Order Summary
                    </h2>


                    <div class="space-y-3 mt-4">

                        <div class="flex justify-between">
                            <span>Subtotal</span>

                            <span>
                                ৳@Model.Subtotal.ToString("N2")
                            </span>
                        </div>


                        <div class="flex justify-between">
                            <span>Discount</span>

                            <span class="text-success">
                                - ৳@Model.DiscountAmount.ToString("N2")
                            </span>
                        </div>


                        <div class="flex justify-between">
                            <span>Delivery Charge</span>

                            <span>
                                ৳@Model.DeliveryCharge.ToString("N2")
                            </span>
                        </div>


                        <div class="divider my-1"></div>


                        <div class="flex justify-between text-lg font-bold">

                            <span>
                                Total
                            </span>

                            <span>
                                ৳@Model.TotalAmount.ToString("N2")
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- PAYMENT -->

            <div class="card bg-base-100 shadow-sm">

                <div class="card-body">

                    <div class="flex justify-between items-center">

                        <h2 class="card-title">
                            Payment
                        </h2>

                        <span class="badge badge-outline">
                            @Model.PaymentStatus.Replace("_", " ")
                        </span>

                    </div>


                    @if (!Model.Payments.Any())
                    {
                        <div class="alert mt-4">
                            No payment record found.
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto mt-4">

                            <table class="table">

                                <thead>
                                    <tr>
                                        <th>Method</th>
                                        <th>Amount</th>
                                        <th>Transaction</th>
                                        <th>Sender</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var payment in Model.Payments)
                                    {
                                        <tr>

                                            <td>
                                                @payment.PaymentMethod
                                            </td>

                                            <td>
                                                ৳@payment.Amount.ToString("N2")
                                            </td>

                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(payment.TransactionId))
                                                {
                                                    <span class="font-mono text-sm">
                                                        @payment.TransactionId
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>

                                            <td>
                                                @payment.SenderName

                                                @if (!string.IsNullOrWhiteSpace(payment.SenderPhone))
                                                {
                                                    <div class="text-xs text-base-content/50">
                                                        @payment.SenderPhone
                                                    </div>
                                                }
                                            </td>

                                            <td>
                                                <span class="badge badge-outline">
                                                    @payment.Status.Replace("_", " ")
                                                </span>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }


                    <!-- Payment Status -->
                    <div class="divider"></div>

                    <form asp-action="UpdatePaymentStatus"
                          method="post"
                          class="flex flex-col md:flex-row gap-3">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <select name="paymentStatus"
                                class="select select-bordered">

                            <option value="unpaid"
                                    selected="@(Model.PaymentStatus == "unpaid")">
                                Unpaid
                            </option>

                            <option value="pending_verification"
                                    selected="@(Model.PaymentStatus == "pending_verification")">
                                Pending Verification
                            </option>

                            <option value="paid"
                                    selected="@(Model.PaymentStatus == "paid")">
                                Paid
                            </option>

                            <option value="failed"
                                    selected="@(Model.PaymentStatus == "failed")">
                                Failed
                            </option>

                            <option value="refunded"
                                    selected="@(Model.PaymentStatus == "refunded")">
                                Refunded
                            </option>

                        </select>


                        <button type="submit"
                                class="btn btn-primary">

                            Update Payment

                        </button>

                    </form>

                </div>

            </div>


            <!-- STATUS HISTORY -->

            <div class="card bg-base-100 shadow-sm">

                <div class="card-body">

                    <h2 class="card-title">
                        Status History
                    </h2>


                    <div class="mt-4">

                        @if (!Model.StatusHistory.Any())
                        {
                            <p class="text-base-content/50">
                                No status history available.
                            </p>
                        }
                        else
                        {
                            <ul class="timeline timeline-vertical">

                                @foreach (var history in Model.StatusHistory)
                                {
                                    <li>

                                        <div class="timeline-start text-sm">
                                             @history.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                         </div>


                                        <div class="timeline-middle">
                                            <div class="w-3 h-3 rounded-full bg-primary"></div>
                                        </div>


                                        <div class="timeline-end timeline-box">

                                            <div class="font-semibold">
                                                @history.Status.Replace("_", " ")
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(history.Note))
                                            {
                                                <div class="text-sm mt-1">
                                                    @history.Note
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(history.ChangedByName))
                                            {
                                                <div class="text-xs text-base-content/50 mt-2">
                                                    Changed by @history.ChangedByName
                                                </div>
                                            }

                                        </div>

                                    </li>
                                }

                            </ul>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- RIGHT SIDEBAR -->
        <!-- ===================================================== -->

        <div class="space-y-6">


            <!-- UPDATE STATUS -->

            <div class="card bg-base-100 shadow-sm">

                <div class="card-body">

                    <h2 class="card-title">
                        Update Order
                    </h2>


                    <form asp-action="UpdateStatus"
                          method="post"
                          class="space-y-4">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />


                        <div>

                            <label class="label">
                                <span class="label-text">
                                    Order Status
                                </span>
                            </label>


                            <select name="status"
                                    class="select select-bordered w-full">

                                @foreach (var status in Model.AvailableStatuses)
                                {
                                    <option value="@status"
                                            selected="@(Model.Status == status)">

                                        @status.Replace("_", " ")

                                    </option>
                                }

                            </select>

                        </div>


                        <div>

                            <label class="label">

                                <span class="label-text">
                                    Note
                                </span>

                            </label>


                            <textarea name="note"
                                      class="textarea textarea-bordered w-full"
                                      placeholder="Optional note..."></textarea>

                        </div>


                        <button type="submit"
                                class="btn btn-primary w-full">

                            Update Status

                        </button>

                    </form>

                </div>

            </div>


            <!-- CUSTOMER -->

            <div class="card bg-base-100 shadow-sm">

                <div class="card-body">

                    <h2 class="card-title">
                        Customer
                    </h2>


                    <div class="space-y-2 mt-3">

                        <div>
                            <div class="text-xs text-base-content/50">
                                Name
                            </div>

                            <div class="font-medium">
                                @Model.CustomerName
                            </div>
                        </div>


                        <div>
                            <div class="text-xs text-base-content/50">
                                Email
                            </div>

                            <div>
                                @Model.CustomerEmail
                            </div>
                        </div>


                        <div>
                            <div class="text-xs text-base-content/50">
                                Phone
                            </div>

                            <div>
                                @Model.CustomerPhone
                            </div>
                        </div>

                    </div>

                </div>

            </div>


            <!-- SHIPPING -->

            <div class="card bg-base-100 shadow-sm">

                <div class="card-body">

                    <h2 class="card-title">
                        Shipping Address
                    </h2>


                    <div class="space-y-2 mt-3">

                        <div class="font-semibold">
                            @Model.ShippingFullName
                        </div>

                        <div>
                            @Model.ShippingPhone
                        </div>

                        <div>
                            @Model.ShippingAddress
                        </div>

                        <div>
                            @Model.ShippingDistrict

                            @if (!string.IsNullOrWhiteSpace(Model.ShippingPostalCode))
                            {
                                <span>
                                    - @Model.ShippingPostalCode
                                </span>
                            }
                        </div>

                        <div>
                            @Model.ShippingCountry
                        </div>


                        @if (!string.IsNullOrWhiteSpace(Model.ShippingDeliveryNote))
                        {
                            <div class="divider my-1"></div>

                            <div>

                                <div class="text-xs text-base-content/50">
                                    Delivery Note
                                </div>

                                <div class="text-sm">
                                    @Model.ShippingDeliveryNote
                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- CUSTOMER NOTE -->
            @if (!string.IsNullOrWhiteSpace(Model.CustomerNote))
            {
                <div class="card bg-base-100 shadow-sm">

                    <div class="card-body">

                        <h2 class="card-title">
                            Customer Note
                        </h2>

                        <p class="text-sm">
                            @Model.CustomerNote
                        </p>

                    </div>

                </div>
            }


        </div>

    </div>

</div>