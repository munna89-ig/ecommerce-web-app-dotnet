@using Pearl_Poetry.Data.Entities
@model IEnumerable<AuditLog>

@{
    ViewData["Title"] = "Audit Logs";

    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 0);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);

    string? search = ViewBag.Search;
    string? selectedAction = ViewBag.Action;
    string? selectedEntityType = ViewBag.EntityType;

    var actions = ViewBag.Actions as List<string> ?? new List<string>();
    var entityTypes = ViewBag.EntityTypes as List<string> ?? new List<string>();
}

<div class="p-6">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

        <div>
            <h1 class="text-3xl font-bold text-gray-800">
                Audit Logs
            </h1>

            <p class="text-gray-500 mt-1">
                Monitor administrative and system activity.
            </p>
        </div>

        <div class="badge badge-neutral badge-lg">
            @totalItems Records
        </div>

    </div>


    <!-- Filters -->
    <div class="card bg-base-100 shadow-md mb-6">

        <div class="card-body">

            <form method="get"
                  asp-area="Admin"
                  asp-controller="AuditLog"
                  asp-action="Index">

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

                    <!-- Search -->
                    <div>
                        <label class="label">
                            <span class="label-text font-semibold">
                                Search
                            </span>
                        </label>

                        <input type="text"
                               name="search"
                               value="@search"
                               placeholder="Action, user, IP..."
                               class="input input-bordered w-full" />
                    </div>


                    <!-- Action -->
                    <div>
                        <label class="label">
                            <span class="label-text font-semibold">
                                Action
                            </span>
                        </label>

                        <select name="action"
                                class="select select-bordered w-full">

                            <option value="">
                                All Actions
                            </option>

                            @foreach (var item in actions)
                            {
                                if (selectedAction == item)
                                {
                                    <option value="@item" selected>
                                        @item
                                    </option>
                                }
                                else
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }
                            }

                        </select>
                    </div>


                    <!-- Entity -->
                    <div>
                        <label class="label">
                            <span class="label-text font-semibold">
                                Entity
                            </span>
                        </label>

                        <select name="entityType"
                                class="select select-bordered w-full">

                            <option value="">
                                All Entities
                            </option>

                            @foreach (var item in entityTypes)
                            {
                                if (selectedEntityType == item)
                                {
                                    <option value="@item" selected>
                                        @item
                                    </option>
                                }
                                else
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }
                            }

                        </select>
                    </div>


                    <!-- Buttons -->
                    <div class="flex items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-1">
                            Search
                        </button>

                        <a asp-area="Admin"
                           asp-controller="AuditLog"
                           asp-action="Index"
                           class="btn btn-ghost">
                            Clear
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Audit Log Table -->
    <div class="card bg-base-100 shadow-md">

        <div class="card-body p-0">

            <div class="overflow-x-auto">

                <table class="table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Date & Time</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Entity ID</th>
                            <th>IP Address</th>
                            <th>Details</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8">

                                    <div class="text-center py-12">

                                        <div class="text-5xl mb-3">
                                            📋
                                        </div>

                                        <h3 class="font-semibold text-lg">
                                            No audit logs found
                                        </h3>

                                        <p class="text-gray-500">
                                            Try changing your search or filters.
                                        </p>

                                    </div>

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model)
                            {
                                <tr class="hover">

                                    <!-- ID -->
                                    <td class="font-mono text-sm">
                                        #@log.Id
                                    </td>


                                    <!-- Date -->
                                    <td>
                                        <div class="font-medium">
                                            @log.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                        </div>

                                        <div class="text-xs text-gray-500">
                                            @log.CreatedAt.ToLocalTime().ToString("hh:mm:ss tt")
                                        </div>
                                    </td>


                                    <!-- User -->
                                    <td>

                                        @if (log.User != null)
                                        {
                                            <div class="font-medium">
                                                @log.User.Name
                                            </div>

                                            <div class="text-xs text-gray-500">
                                                @log.User.Email
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge badge-ghost">
                                                System / Deleted User
                                            </span>
                                        }

                                    </td>


                                    <!-- Action -->
                                    <td>

                                        @{
                                            string actionClass = "badge-neutral";

                                            var lowerAction =
                                            log.Action?.ToLower() ?? "";

                                            if (lowerAction.Contains("create") ||
                                            lowerAction.Contains("add"))
                                            {
                                                actionClass = "badge-success";
                                            }
                                            else if (lowerAction.Contains("update") ||
                                            lowerAction.Contains("edit"))
                                            {
                                                actionClass = "badge-info";
                                            }
                                            else if (lowerAction.Contains("delete") ||
                                            lowerAction.Contains("remove"))
                                            {
                                                actionClass = "badge-error";
                                            }
                                            else if (lowerAction.Contains("login"))
                                            {
                                                actionClass = "badge-primary";
                                            }
                                        }

                                        <span class="badge @actionClass">
                                            @log.Action
                                        </span>

                                    </td>


                                    <!-- Entity -->
                                    <td>
                                        <span class="badge badge-outline">
                                            @log.EntityType
                                        </span>
                                    </td>


                                    <!-- Entity ID -->
                                    <td class="font-mono">
                                        @if (log.EntityId.HasValue)
                                        {
                                            <span>
                                                #@log.EntityId
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400">
                                                —
                                            </span>
                                        }
                                    </td>


                                    <!-- IP -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(log.IpAddress))
                                        {
                                            <span class="font-mono text-sm">
                                                @log.IpAddress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400">
                                                —
                                            </span>
                                        }
                                    </td>


                                    <!-- Details -->
                                    <td>

                                        <a asp-area="Admin"
                                           asp-controller="AuditLog"
                                           asp-action="Details"
                                           asp-route-id="@log.Id"
                                           class="btn btn-sm btn-ghost">

                                            View

                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="flex justify-center mt-6">

            <div class="join">

                @if (currentPage > 1)
                {
                    <a class="join-item btn"
                       asp-area="Admin"
                       asp-controller="AuditLog"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-search="@search"
                       asp-route-action="@selectedAction"
                       asp-route-entityType="@selectedEntityType">

                        «

                    </a>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == currentPage)
                    {
                        <a class="join-item btn btn-primary">
                            @i
                        </a>
                    }
                    else if (
                    i == 1 ||
                    i == totalPages ||
                    Math.Abs(i - currentPage) <= 2)
                    {
                        <a class="join-item btn"
                           asp-area="Admin"
                           asp-controller="AuditLog"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@search"
                           asp-route-action="@selectedAction"
                           asp-route-entityType="@selectedEntityType">

                            @i

                        </a>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a class="join-item btn"
                       asp-area="Admin"
                       asp-controller="AuditLog"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-search="@search"
                       asp-route-action="@selectedAction"
                       asp-route-entityType="@selectedEntityType">

                        »

                    </a>
                }

            </div>

        </div>
    }

</div>