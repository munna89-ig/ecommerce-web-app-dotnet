@using Pearl_Poetry.Data.Entities
@model AuditLog

@{
    ViewData["Title"] = "Audit Log Details";
}

<div class="p-6 max-w-7xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

        <div>
            <div class="breadcrumbs text-sm">
                <ul>
                    <li>
                        <a asp-area="Admin"
                           asp-controller="AuditLog"
                           asp-action="Index">
                            Audit Logs
                        </a>
                    </li>
                    <li>Details</li>
                </ul>
            </div>

            <h1 class="text-3xl font-bold mt-2">
                Audit Log #@Model.Id
            </h1>
        </div>

        <a asp-area="Admin"
           asp-controller="AuditLog"
           asp-action="Index"
           class="btn btn-ghost">

            ← Back to Logs

        </a>

    </div>


    <!-- Basic Information -->
    <div class="card bg-base-100 shadow-md mb-6">

        <div class="card-body">

            <h2 class="card-title mb-4">
                Activity Information
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

                <div>
                    <p class="text-sm text-gray-500">
                        Action
                    </p>

                    <p class="font-semibold mt-1">
                        @Model.Action
                    </p>
                </div>


                <div>
                    <p class="text-sm text-gray-500">
                        Entity Type
                    </p>

                    <p class="font-semibold mt-1">
                        @Model.EntityType
                    </p>
                </div>


                <div>
                    <p class="text-sm text-gray-500">
                        Entity ID
                    </p>

                    <p class="font-semibold mt-1 font-mono">
                        @(Model.EntityId?.ToString() ?? "N/A")
                    </p>
                </div>


                <div>
                    <p class="text-sm text-gray-500">
                        IP Address
                    </p>

                    <p class="font-semibold mt-1 font-mono">
                        @(Model.IpAddress ?? "N/A")
                    </p>
                </div>


                <div>
                    <p class="text-sm text-gray-500">
                        Date & Time
                    </p>

                    <p class="font-semibold mt-1">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </p>
                </div>


                <div>
                    <p class="text-sm text-gray-500">
                        User ID
                    </p>

                    <p class="font-semibold mt-1">
                        @(Model.UserId?.ToString() ?? "System")
                    </p>
                </div>


                <div>
                    <p class="text-sm text-gray-500">
                        User
                    </p>

                    @if (Model.User != null)
                    {
                        <p class="font-semibold mt-1">
                            @Model.User.Name
                        </p>

                        <p class="text-xs text-gray-500">
                            @Model.User.Email
                        </p>
                    }
                    else
                    {
                        <p class="font-semibold mt-1">
                            System / Deleted User
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- Old / New Values -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Old Values -->
        <div class="card bg-base-100 shadow-md">

            <div class="card-body">

                <h2 class="card-title">
                    Old Values
                </h2>

                @if (!string.IsNullOrWhiteSpace(Model.OldValues))
                {
                    <div class="mockup-code mt-3 overflow-x-auto">

                        <pre class="p-4"><code>@Model.OldValues</code></pre>

                    </div>
                }
                else
                {
                    <div class="alert alert-ghost mt-3">
                        No previous values recorded.
                    </div>
                }

            </div>

        </div>


        <!-- New Values -->
        <div class="card bg-base-100 shadow-md">

            <div class="card-body">

                <h2 class="card-title">
                    New Values
                </h2>

                @if (!string.IsNullOrWhiteSpace(Model.NewValues))
                {
                    <div class="mockup-code mt-3 overflow-x-auto">

                        <pre class="p-4"><code>@Model.NewValues</code></pre>

                    </div>
                }
                else
                {
                    <div class="alert alert-ghost mt-3">
                        No new values recorded.
                    </div>
                }

            </div>

        </div>

    </div>

</div>