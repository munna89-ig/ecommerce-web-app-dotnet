@using Pearl_Poetry.Enums

@model Pearl_Poetry.ViewModels.Admin.Product.ProductEditViewModel

@{
    ViewData["Title"] = "Edit Product";
}
@if (TempData["Success"] != null)
{
    <div class="alert-success-custom">
        @TempData["Success"]
    </div>
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="max-w-5xl mx-auto">

    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold">
                Edit Product
            </h1>

            <p class="text-base-content/60 mt-1">
                Update product information
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline">
            Back to Products
        </a>
    </div>


    <form asp-action="EditProduct"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <input asp-for="ExistingCoverImagePath"
               type="hidden" />


        <div asp-validation-summary="ModelOnly"
             class="alert alert-error mb-6">
        </div>


        <!-- BASIC INFORMATION -->

        <div class="card bg-base-100 shadow-md mb-6">

            <div class="card-body">

                <h2 class="card-title">
                    Basic Information
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- Title -->

                    <div class="form-control md:col-span-2">

                        <label class="label">
                            <span class="label-text">
                                Product Title
                            </span>
                        </label>

                        <input asp-for="Title"
                               class="input input-bordered"
                               placeholder="Product title" />

                        <span asp-validation-for="Title"
                              class="text-error text-sm">
                        </span>

                    </div>


                    <!-- SKU -->

                    <div class="form-control">

                        <label class="label">
                            <span class="label-text">
                                SKU
                            </span>
                        </label>

                        <input asp-for="Sku"
                               class="input input-bordered"
                               placeholder="SKU-001" />

                        <span asp-validation-for="Sku"
                              class="text-error text-sm">
                        </span>

                    </div>


                    <!-- Category -->

                    <div class="form-control">

                        <label class="label">
                            <span class="label-text">
                                Category
                            </span>
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.Categories"
                                class="select select-bordered">

                            <option value="">
                                Select Category
                            </option>

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-error text-sm">
                        </span>

                    </div>


                    <!-- Product Type -->

                    <div class="form-control">

                        <label class="label">
                            <span class="label-text">
                                Product Type
                            </span>
                        </label>

                        <select asp-for="ProductType"
                                class="select select-bordered"
                                asp-items="Html.GetEnumSelectList<ProductType>()">
                        </select>

                    </div>

                </div>

            </div>

        </div>


        <!-- DESCRIPTION -->

        <div class="card bg-base-100 shadow-md mb-6">

            <div class="card-body">

                <h2 class="card-title">
                    Description
                </h2>

                <div class="form-control mb-4">

                    <label class="label">
                        <span class="label-text">
                            Short Description
                        </span>
                    </label>

                    <textarea asp-for="ShortDescription"
                              class="textarea textarea-bordered"
                              rows="3"></textarea>

                </div>


                <div class="form-control">

                    <label class="label">
                        <span class="label-text">
                            Description
                        </span>
                    </label>

                    <textarea asp-for="Description"
                              class="textarea textarea-bordered"
                              rows="7"></textarea>

                </div>

            </div>

        </div>


        <!-- PRICE & INVENTORY -->

        <div class="card bg-base-100 shadow-md mb-6">

            <div class="card-body">

                <h2 class="card-title">
                    Price & Inventory
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

                    <div class="form-control">

                        <label class="label">
                            <span class="label-text">
                                Price
                            </span>
                        </label>

                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               class="input input-bordered" />

                    </div>


                    <div class="form-control">

                        <label class="label">
                            <span class="label-text">
                                Discount Price
                            </span>
                        </label>

                        <input asp-for="DiscountPrice"
                               type="number"
                               step="0.01"
                               class="input input-bordered" />

                    </div>


                    <div class="form-control">

                        <label class="label">
                            <span class="label-text">
                                Quantity
                            </span>
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="0"
                               class="input input-bordered" />

                    </div>

                </div>

            </div>

        </div>


        <!-- IMAGE -->

        <div class="card bg-base-100 shadow-md mb-6">

            <div class="card-body">

                <h2 class="card-title">
                    Product Image
                </h2>


                @if (!string.IsNullOrEmpty(
                                Model.ExistingCoverImagePath))
                {
                    <div class="mb-4">

                        <p class="text-sm mb-2">
                            Current Image
                        </p>

                        <img src="@Model.ExistingCoverImagePath"
                             alt="@Model.Title"
                             class="w-40 h-40 object-cover rounded-lg border" />

                    </div>
                }


                <div class="form-control">

                    <label class="label">
                        <span class="label-text">
                            Replace Cover Image
                        </span>
                    </label>

                    <input asp-for="CoverImage"
                           type="file"
                           accept="image/*"
                           class="file-input file-input-bordered w-full" />

                    <label class="label">
                        <span class="label-text-alt">
                            Leave empty to keep the current image.
                        </span>
                    </label>

                </div>

            </div>

        </div>


        <!-- SETTINGS -->

        <div class="card bg-base-100 shadow-md mb-6">

            <div class="card-body">

                <h2 class="card-title">
                    Product Settings
                </h2>


                <label class="cursor-pointer flex items-center gap-3">

                    <input asp-for="IsFeatured"
                           type="checkbox"
                           class="checkbox checkbox-primary" />

                    <span>
                        Featured Product
                    </span>

                </label>


                <label class="cursor-pointer flex items-center gap-3">

                    <input asp-for="IsActive"
                           type="checkbox"
                           class="checkbox checkbox-success" />

                    <span>
                        Active Product
                    </span>

                </label>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="flex justify-end gap-3">

            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Index"
               class="btn btn-ghost">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">

                Save Changes

            </button>

        </div>

    </form>

</div>


@section Scripts {

    @await Html.PartialAsync("_ValidationScriptsPartial")

}