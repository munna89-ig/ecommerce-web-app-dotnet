@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject Pearl_Poetry.Data.EcommerceSystemContext LayoutDb
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    // ---------- from Admin > Settings ----------
    var siteSettings = await LayoutDb.Settings.AsNoTracking().OrderBy(s => s.Id).FirstOrDefaultAsync();

    string siteName = string.IsNullOrWhiteSpace(siteSettings?.SiteName) ? "Pearl Poetry" : siteSettings!.SiteName!.Trim();
    string siteDescription = string.IsNullOrWhiteSpace(siteSettings?.ShortDescription)
        ? "Admin panel"
        : siteSettings!.ShortDescription!;

    // ---------- live notifications ----------
    int pendingOrders = await LayoutDb.Orders.CountAsync(o => o.Status == "pending");
    int pendingPayments = await LayoutDb.Payments.CountAsync(p => p.Status == "pending_verification" || p.Status == "pending");
    int notificationCount = pendingOrders + pendingPayments;
}
<!DOCTYPE html>
<html lang="en" data-theme="pearlpoetry">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName Admin</title>
    <meta name="description" content="@siteName Admin Panel" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Your Tailwind/DaisyUI compiled CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        html {
            font-family: 'Poppins', sans-serif;
        }

        .font-display {
            font-family: 'Playfair Display', serif;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen bg-base-200 text-base-content">

    <!-- ========================================================= -->
    <!-- DRAWER (handles the responsive sidebar, no JS required)   -->
    <!-- ========================================================= -->
    <div class="drawer lg:drawer-open">

        <input id="admin-drawer" type="checkbox" class="drawer-toggle" />

        <!-- ===================================================== -->
        <!-- MAIN CONTENT SIDE -->
        <!-- ===================================================== -->
        <div class="drawer-content flex flex-col min-h-screen">

            <!-- TOP NAVBAR -->
            <header class="navbar sticky top-0 z-40 bg-base-100 border-b border-base-300 shadow-sm px-4 lg:px-6">

                <div class="flex-1 flex items-center gap-4">

                    <!-- Mobile drawer toggle -->
                    <label for="admin-drawer" class="btn btn-ghost btn-circle lg:hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </label>

                    <div class="hidden sm:block">
                        <div class="text-xl font-bold text-primary">@siteName</div>
                        <div class="text-xs text-base-content/50">Admin Panel</div>
                    </div>

                </div>

                <div class="flex-none flex items-center gap-2">

                    <!-- Search -->
                    <input type="search" placeholder="Search..." class="input input-bordered input-sm w-48 hidden md:block" />

                    <!-- Notifications (live counts) -->
                    <div class="dropdown dropdown-end">
                        <button tabindex="0" type="button" class="btn btn-ghost btn-circle" aria-label="Notifications">
                            <div class="indicator">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                                </svg>
                                @if (notificationCount > 0)
                                {
                                    <span class="badge badge-primary badge-sm indicator-item">@notificationCount</span>
                                }
                            </div>
                        </button>
                        <div tabindex="0" class="dropdown-content z-50 card card-compact w-64 bg-base-100 shadow-xl">
                            <div class="card-body">
                                <h3 class="font-semibold">Notifications</h3>
                                <div class="divider my-1"></div>

                                @if (notificationCount == 0)
                                {
                                    <p class="text-sm text-base-content/60">You're all caught up.</p>
                                }
                                @if (pendingOrders > 0)
                                {
                                    <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="pending"
                                       class="text-sm link link-hover">
                                        @pendingOrders new order@(pendingOrders == 1 ? "" : "s") pending
                                    </a>
                                }
                                @if (pendingPayments > 0)
                                {
                                    <a asp-area="Admin" asp-controller="Payment" asp-action="Index" asp-route-status="pending_verification"
                                       class="text-sm link link-hover">
                                        @pendingPayments payment@(pendingPayments == 1 ? "" : "s") awaiting confirmation
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- User -->
                    <div class="dropdown dropdown-end">
                        <button tabindex="0" type="button" class="btn btn-ghost flex items-center gap-2">
                            <div class="avatar placeholder">
                                <div class="w-10 rounded-full bg-primary text-primary-content">
                                    <span class="font-bold">
                                        @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "A")
                                    </span>
                                </div>
                            </div>
                            <div class="hidden md:block text-left">
                                <div class="font-semibold">@User.Identity?.Name</div>
                                <div class="text-xs text-base-content/50">Administrator</div>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        <ul tabindex="0" class="dropdown-content z-50 menu p-2 shadow-xl bg-base-100 rounded-box w-56">
                            <li class="menu-title"><span>@User.Identity?.Name</span></li>
                            <li><a asp-area="" asp-controller="Account" asp-action="Profile">Profile</a></li>
                            <li><a asp-area="Admin" asp-controller="Settings" asp-action="Index">Settings</a></li>
                            <li><a asp-area="" asp-controller="Home" asp-action="Index" target="_blank">View Shop</a></li>
                            <li>
                                <form asp-area=""
                                      asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="p-0">
                                    <button type="submit" class="w-full text-left">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>

                </div>

            </header>

            <!-- PAGE CONTENT -->
            <main class="flex-1 p-4 md:p-6 lg:p-8">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="footer bg-neutral text-neutral-content px-6 lg:px-8 py-10 gap-8">

                <aside>
                    <h3 class="text-2xl font-display font-bold text-primary mb-1">@siteName</h3>
                    <p class="text-neutral-content/60 text-sm max-w-xs">
                        @siteDescription
                    </p>
                </aside>

                <nav>
                    <h4 class="footer-title">Administration</h4>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="link link-hover">Dashboard</a>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="link link-hover">Products</a>
                    <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="link link-hover">Orders</a>
                </nav>

                <nav>
                    <h4 class="footer-title">Management</h4>
                    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="link link-hover">Users</a>
                    <a asp-area="Admin" asp-controller="Coupon" asp-action="Index" class="link link-hover">Coupons</a>
                    <a asp-area="Admin" asp-controller="Banner" asp-action="Index" class="link link-hover">Banners</a>
                    <a asp-area="Admin" asp-controller="Payment" asp-action="Index" class="link link-hover">Payments</a>
                </nav>

                <nav>
                    <h4 class="footer-title">System</h4>
                    <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="link link-hover">Settings</a>
                    <a asp-area="Admin" asp-controller="AuditLog" asp-action="Index" class="link link-hover">Audit Logs</a>
                </nav>

            </footer>

            <footer class="footer footer-center bg-neutral text-neutral-content/60 border-t border-neutral-content/10 py-4 text-sm">
                <p>&copy; @DateTime.Now.Year @siteName. All rights reserved. &middot; Admin Panel</p>
            </footer>

        </div>

        <!-- ===================================================== -->
        <!-- SIDEBAR (drawer-side) -->
        <!-- ===================================================== -->
        <div class="drawer-side z-50">

            <label for="admin-drawer" aria-label="close sidebar" class="drawer-overlay"></label>

            <aside class="min-h-full w-64 bg-neutral text-neutral-content flex flex-col">

                <!-- Sidebar Logo -->
                <div class="h-20 flex items-center px-6 border-b border-neutral-content/10">
                    <div>
                        <div class="text-xl font-bold text-primary">@siteName</div>
                        <div class="text-xs text-neutral-content/50 mt-1">Admin Panel</div>
                    </div>
                </div>

                <!-- Navigation -->
                <ul class="menu menu-md p-4 flex-1">

                    <li>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                           class="@(currentController == "Dashboard" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                            </svg>
                            Dashboard
                        </a>
                    </li>

                    <div class="divider my-1"></div>

                    <!-- Products (native collapsible submenu, no JS needed) -->
                    <li>
                        <details @(currentController == "Product" || currentController == "Category" ? "open" : null)>
                            <summary>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 6H6.28l-.31-1.243A1 1 0 005 4H3z" />
                                </svg>
                                Products
                            </summary>
                            <ul>
                                <li><a asp-area="Admin" asp-controller="Product" asp-action="Index">All Products</a></li>
                                <li><a asp-area="Admin" asp-controller="Product" asp-action="AddProduct">Add Product</a></li>
                                <li><a asp-area="Admin" asp-controller="Category" asp-action="Index">Categories</a></li>
                            </ul>
                        </details>
                    </li>

                    <li>
                        <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                           class="@(currentController == "Order" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" />
                            </svg>
                            Orders
                            @if (pendingOrders > 0)
                            {
                                <span class="badge badge-primary badge-sm ml-auto">@pendingOrders</span>
                            }
                        </a>
                    </li>

                    <li>
                        <a asp-area="Admin" asp-controller="User" asp-action="Index"
                           class="@(currentController == "User" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path fill-rule="evenodd" d="M2 17a7 7 0 1114 0H2z" clip-rule="evenodd" />
                            </svg>
                            Users
                        </a>
                    </li>

                    <li>
                        <a asp-area="Admin" asp-controller="Coupon" asp-action="Index"
                           class="@(currentController == "Coupon" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M3 7a2 2 0 012-2h10a2 2 0 012 2v1a2 2 0 110 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2v-1a2 2 0 110-4V7z" />
                            </svg>
                            Coupons
                        </a>
                    </li>

                    <!-- Banners (home page slider) -->
                    <li>
                        <a asp-area="Admin" asp-controller="Banner" asp-action="Index"
                           class="@(currentController == "Banner" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                            </svg>
                            Banners
                        </a>
                    </li>

                    <li>
                        <a asp-area="Admin" asp-controller="Payment" asp-action="Index"
                           class="@(currentController == "Payment" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm0 4h12v2H4V8z" />
                            </svg>
                            Payments
                            @if (pendingPayments > 0)
                            {
                                <span class="badge badge-warning badge-sm ml-auto">@pendingPayments</span>
                            }
                        </a>
                    </li>

                    <li>
                        <a asp-area="Admin" asp-controller="Analytics" asp-action="Index"
                           class="@(currentController == "Analytics" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z" />
                            </svg>
                            Analytics
                        </a>
                    </li>

                    <div class="divider my-1"></div>

                    <li>
                        <a asp-area="Admin" asp-controller="Settings" asp-action="Index"
                           class="@(currentController == "Settings" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042.947 2.287 1.561.379 1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942.734 2.106a1.532 1.532 0 012.287.947c.379 1.561 1.561 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                            </svg>
                            Settings
                        </a>
                    </li>

                    <li>
                        <a asp-area="Admin" asp-controller="AuditLog" asp-action="Index"
                           class="@(currentController == "AuditLog" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M4 5a2 2 0 012-2h8a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 2h6v2H7V7zm0 4h6v2H7v-2z" clip-rule="evenodd" />
                            </svg>
                            Audit Logs
                        </a>
                    </li>

                </ul>

            </aside>

        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>