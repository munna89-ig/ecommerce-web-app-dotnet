@model Pearl_Poetry.ViewModels.Admin.Banners.BannerFormViewModel
@using Pearl_Poetry.ViewModels.Admin.Banners
@{
    ViewData["Title"] = Model.IsNew ? "Add Banner" : "Edit Banner";
    string? current = Model.ImagePath == null ? null : BannerFormViewModel.ImageUrl(Model.ImagePath);
}

<div class="p-6 max-w-3xl">

    <div class="mb-6">
        <a asp-action="Index" class="link link-hover text-sm text-base-content/60">&larr; Back to banners</a>
        <h1 class="text-3xl font-bold mt-2">@ViewData["Title"]</h1>
    </div>

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">

            <form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@(Model.IsNew ? null : Model.Id)"
                  method="post" enctype="multipart/form-data" novalidate>

                <input type="hidden" asp-for="Id" />

                <!-- Image + preview -->
                <div class="form-control mb-5">
                    <label class="label" asp-for="ImageFile">
                        <span class="label-text font-medium">Banner image @(Model.IsNew ? "*" : "")</span>
                    </label>

                    <div style="height:200px;border-radius:12px;background:#f4ede6;overflow:hidden;margin-bottom:10px;display:flex;align-items:center;justify-content:center;">
                        <img id="bnPreview" src="@current" alt="Preview"
                             style="width:100%;height:100%;object-fit:contain;@(current == null ? "display:none;" : "")" />
                        <span id="bnEmpty" class="text-sm text-base-content/50" style="@(current != null ? "display:none;" : "")">
                            No image selected
                        </span>
                    </div>

                    <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,.gif"
                           class="file-input file-input-bordered w-full" id="bnFile" />
                    <span class="text-xs text-base-content/50 mt-1">
                        Wide image works best (about 950 × 250 px). Max 5 MB.
                        @if (!Model.IsNew)
                        {
                            <text>Leave empty to keep the current image.</text>
                        }
                    </span>
                    <span asp-validation-for="ImageFile" class="text-error text-sm"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-control">
                        <label class="label" asp-for="Title"><span class="label-text">Title (optional)</span></label>
                        <input asp-for="Title" class="input input-bordered w-full" placeholder="e.g. Eid Sale 30% off" />
                        <span asp-validation-for="Title" class="text-error text-sm"></span>
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="SortOrder"><span class="label-text">Order</span></label>
                        <input asp-for="SortOrder" type="number" min="0" max="999" class="input input-bordered w-full" />
                        <span class="text-xs text-base-content/50 mt-1">1 shows first, 2 second ...</span>
                        <span asp-validation-for="SortOrder" class="text-error text-sm"></span>
                    </div>

                    <div class="form-control md:col-span-2">
                        <label class="label" asp-for="LinkUrl"><span class="label-text">Link (optional)</span></label>
                        <input asp-for="LinkUrl" class="input input-bordered w-full"
                               placeholder="/Product/Search?category=jewelry" />
                        <span class="text-xs text-base-content/50 mt-1">Where the customer goes when clicking the banner.</span>
                        <span asp-validation-for="LinkUrl" class="text-error text-sm"></span>
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="StartDate"><span class="label-text">Show from</span></label>
                        <input asp-for="StartDate" type="date" class="input input-bordered w-full" />
                        <span class="text-xs text-base-content/50 mt-1">Empty = from now</span>
                    </div>

                    <div class="form-control">
                        <label class="label" asp-for="EndDate"><span class="label-text">Show until</span></label>
                        <input asp-for="EndDate" type="date" class="input input-bordered w-full" />
                        <span class="text-xs text-base-content/50 mt-1">Empty = no end</span>
                        <span asp-validation-for="EndDate" class="text-error text-sm"></span>
                    </div>

                    <div class="form-control md:col-span-2">
                        <label class="label cursor-pointer justify-start gap-3">
                            <input asp-for="IsActive" type="checkbox" class="toggle toggle-primary" />
                            <span class="label-text">Show this banner on the home page</span>
                        </label>
                    </div>
                </div>

                <div class="flex gap-3 mt-6">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> @(Model.IsNew ? "Add Banner" : "Save Changes")
                    </button>
                    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // preview before upload
        (function () {
            const input = document.getElementById('bnFile');
            const img = document.getElementById('bnPreview');
            const empty = document.getElementById('bnEmpty');
            if (!input) return;

            input.addEventListener('change', function () {
                const file = input.files && input.files[0];
                if (!file) return;
                img.src = URL.createObjectURL(file);
                img.style.display = '';
                if (empty) empty.style.display = 'none';
            });
        })();
    </script>
}