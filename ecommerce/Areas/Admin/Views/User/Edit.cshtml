@using Pearl_Poetry.Enums
@model Pearl_Poetry.Models.ViewModels.Admin.UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="usr-page">

    <a asp-action="Index" class="usr-back"><i class="fa-solid fa-arrow-left"></i> Back to users</a>

    <div class="usr-header">
        <div>
            <h1>Edit User</h1>
            <p>@Model.Email</p>
        </div>
        <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="usr-btn usr-btn-ghost">
            <i class="fa-solid fa-key"></i> Reset Password
        </a>
    </div>

    <div class="usr-card usr-form-card">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="usr-alert usr-alert-error usr-validation-summary"></div>

            <div class="usr-grid">
                <div class="usr-field">
                    <label asp-for="Name">Full Name <span>*</span></label>
                    <input asp-for="Name" />
                    <span asp-validation-for="Name"></span>
                </div>

                <div class="usr-field">
                    <label asp-for="Email">Email <span>*</span></label>
                    <input asp-for="Email" type="email" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="usr-field">
                    <label asp-for="Phone">Phone</label>
                    <input asp-for="Phone" type="tel" placeholder="01XXXXXXXXX" />
                    <span asp-validation-for="Phone"></span>
                </div>

                <div class="usr-field">
                    <label asp-for="Role">Role <span>*</span></label>
                    <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()"></select>
                    <span asp-validation-for="Role"></span>
                </div>

                <div class="usr-field">
                    <div class="usr-inline">
                        <label class="usr-switch">
                            <input asp-for="IsActive" type="checkbox" />
                            <span class="usr-slider"></span>
                        </label>
                        <span>Account active</span>
                    </div>
                    <span asp-validation-for="IsActive"></span>
                </div>
            </div>

            <div class="usr-form-foot">
                <a asp-action="Index" class="usr-btn usr-btn-ghost">Cancel</a>
                <button type="submit" class="usr-btn usr-btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}