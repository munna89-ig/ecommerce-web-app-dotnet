@model Pearl_Poetry.ViewModels.Account.ProfileViewModel
@using System.Globalization
@{
    ViewData["Title"] = "My Profile";
    ViewData["ShowChrome"] = true;

    string M(decimal v) => "\u09F3 " + v.ToString("N2", CultureInfo.InvariantCulture);
    string Label(string? s) => string.IsNullOrWhiteSpace(s)
        ? "-"
        : CultureInfo.InvariantCulture.TextInfo.ToTitleCase(s.Replace('_', ' '));
    string Active(string tab) => Model.ActiveTab == tab ? "is-active" : "";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="shop-container">

    <nav class="breadcrumb">
        <a href="/">Home</a><span>/</span><span>My Profile</span>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="pp-alert is-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="pf-layout">

        <!-- ================= LEFT: user card ================= -->
        <aside class="pf-card pf-side">

            <div class="pf-avatar">
                @if (Model.PhotoUrl != null)
                {
                    <img src="@Model.PhotoUrl" alt="@Model.Name"
                         onerror="this.remove();" />
                }
                <span>@Model.Initials</span>
            </div>

            <h2 class="pf-name">@Model.Name</h2>
            <p class="pf-email">@Model.Email</p>

            <div class="pf-tags">
                <span class="pf-role">@Model.Role</span>
                @if (Model.CreatedAt.HasValue)
                {
                    <span class="pf-since">
                        <i class="fa-regular fa-calendar"></i>
                        Since @Model.CreatedAt.Value.ToLocalTime().ToString("MMM yyyy")
                    </span>
                }
            </div>

            <div class="pf-stats">
                <div>
                    <b>@Model.TotalOrders</b>
                    <small>Orders</small>
                </div>
                <div>
                    <b>@Model.ActiveOrders</b>
                    <small>Active</small>
                </div>
                <div>
                    <b>@Model.WishlistCount</b>
                    <small>Wishlist</small>
                </div>
            </div>

            <div class="pf-spent">
                <span>Total spent</span>
                <b>@M(Model.TotalSpent)</b>
            </div>

            <nav class="pf-nav">
                <button type="button" class="@Active("overview")" data-tab="overview">
                    <i class="fa-regular fa-user"></i> Overview
                </button>
                <button type="button" class="@Active("edit")" data-tab="edit">
                    <i class="fa-regular fa-pen-to-square"></i> Edit Profile
                </button>
                <button type="button" class="@Active("password")" data-tab="password">
                    <i class="fa-solid fa-key"></i> Change Password
                </button>
                <a href="/Wishlist"><i class="fa-regular fa-heart"></i> My Wishlist</a>
                <a href="/Cart"><i class="fa-solid fa-cart-shopping"></i> My Cart</a>

                @if (Model.Role == Pearl_Poetry.Enums.UserRole.Admin)
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="fa-solid fa-gauge"></i> Admin Dashboard
                    </a>
                }
            </nav>

            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline btn-block">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
                </button>
            </form>
        </aside>

        <!-- ================= RIGHT: tabs ================= -->
        <section class="pf-main">

            <!-- ---------- OVERVIEW ---------- -->
            <div class="pf-card pf-panel @Active("overview")" data-panel="overview">
                <div class="pf-head">
                    <h3>Account Details</h3>
                    <button type="button" class="pf-link" data-tab="edit">
                        <i class="fa-regular fa-pen-to-square"></i> Edit
                    </button>
                </div>

                <dl class="pf-details">
                    <div><dt>Full Name</dt><dd>@Model.Name</dd></div>
                    <div><dt>Email</dt><dd>@Model.Email</dd></div>
                    <div><dt>Phone</dt><dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not added" : Model.Phone)</dd></div>
                    <div>
                        <dt>Member Since</dt>
                        <dd>@(Model.CreatedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "-")</dd>
                    </div>
                </dl>
            </div>

            <div class="pf-card pf-panel @Active("overview")" data-panel="overview">
                <div class="pf-head">
                    <h3>Recent Orders</h3>
                </div>

                @if (Model.RecentOrders.Count == 0)
                {
                    <div class="pf-empty">
                        <i class="fa-solid fa-bag-shopping"></i>
                        <p>You haven't placed any order yet.</p>
                        <a href="/" class="btn btn-primary">Start Shopping</a>
                    </div>
                }
                else
                {
                    <div class="pf-table-wrap">
                        <table class="pf-table">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Date</th>
                                    <th>Items</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Payment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model.RecentOrders)
                                {
                                    <tr>
                                        <td data-label="Order"><b>#@o.OrderNumber</b></td>
                                        <td data-label="Date">@(o.CreatedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "-")</td>
                                        <td data-label="Items">@o.ItemCount</td>
                                        <td data-label="Total">@M(o.TotalAmount)</td>
                                        <td data-label="Status">
                                            <span class="pf-badge s-@o.Status">@Label(o.Status)</span>
                                        </td>
                                        <td data-label="Payment">
                                            <span class="pf-badge p-@o.PaymentStatus">@Label(o.PaymentStatus)</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- ---------- EDIT PROFILE ---------- -->
            <div class="pf-card pf-panel @Active("edit")" data-panel="edit">
                <div class="pf-head">
                    <h3>Edit Profile</h3>
                </div>

                @if (Model.EditError != null)
                {
                    <div class="pp-alert">@Model.EditError</div>
                }

                <form asp-area="" asp-controller="Account" asp-action="UpdateProfile"
                      method="post" enctype="multipart/form-data" novalidate>

                    <div class="pf-photo">
                        <div class="pf-avatar sm" id="pfPreview">
                            @if (Model.PhotoUrl != null)
                            {
                                <img src="@Model.PhotoUrl" alt="" onerror="this.remove();" />
                            }
                            <span>@Model.Initials</span>
                        </div>

                        <div>
                            <label class="btn btn-ghost pf-upload">
                                <i class="fa-solid fa-camera"></i> Choose Photo
                                <input asp-for="Edit.Photo" accept=".jpg,.jpeg,.png,.webp,.gif" id="pfPhoto" hidden />
                            </label>
                            <small class="pf-hint">JPG, PNG, WEBP or GIF &middot; max 5 MB</small>

                            @if (Model.PhotoUrl != null)
                            {
                                <label class="remember">
                                    <input asp-for="Edit.RemovePhoto" type="checkbox" id="pfRemove" />
                                    Remove current photo
                                </label>
                            }
                        </div>
                    </div>

                    <div class="ck-grid">
                        <div class="field">
                            <label asp-for="Edit.Name">Full Name <em>*</em></label>
                            <input asp-for="Edit.Name" autocomplete="name" />
                            <span asp-validation-for="Edit.Name"></span>
                        </div>

                        <div class="field">
                            <label asp-for="Edit.Phone">Phone</label>
                            <input asp-for="Edit.Phone" placeholder="01712345678" autocomplete="tel" />
                            <span asp-validation-for="Edit.Phone"></span>
                        </div>

                        <div class="field full">
                            <label>Email</label>
                            <input value="@Model.Email" disabled />
                            <small class="pf-hint">Email can't be changed.</small>
                        </div>
                    </div>

                    <div class="pf-actions">
                        <button type="button" class="btn btn-ghost" data-tab="overview">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>

            <!-- ---------- CHANGE PASSWORD ---------- -->
            <div class="pf-card pf-panel @Active("password")" data-panel="password">
                <div class="pf-head">
                    <h3>Change Password</h3>
                </div>

                @if (Model.PasswordError != null)
                {
                    <div class="pp-alert">@Model.PasswordError</div>
                }

                <form asp-area="" asp-controller="Account" asp-action="ChangePassword"
                      method="post" novalidate class="pf-pw-form">

                    <div class="field">
                        <label asp-for="Password.CurrentPassword"></label>
                        <div class="pf-pw">
                            <input asp-for="Password.CurrentPassword" autocomplete="current-password" />
                            <button type="button" class="pf-eye" aria-label="Show password"><i class="fa-regular fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password.CurrentPassword"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password.NewPassword"></label>
                        <div class="pf-pw">
                            <input asp-for="Password.NewPassword" autocomplete="new-password" />
                            <button type="button" class="pf-eye" aria-label="Show password"><i class="fa-regular fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password.NewPassword"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password.ConfirmPassword"></label>
                        <div class="pf-pw">
                            <input asp-for="Password.ConfirmPassword" autocomplete="new-password" />
                            <button type="button" class="pf-eye" aria-label="Show password"><i class="fa-regular fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password.ConfirmPassword"></span>
                    </div>

                    <div class="pf-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-key"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>

        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            // ---------- tabs ----------
            function show(tab) {
                document.querySelectorAll('[data-panel]').forEach(p =>
                    p.classList.toggle('is-active', p.dataset.panel === tab));

                document.querySelectorAll('.pf-nav [data-tab]').forEach(b =>
                    b.classList.toggle('is-active', b.dataset.tab === tab));

                try {
                    const url = new URL(window.location.href);
                    url.searchParams.set('tab', tab);
                    history.replaceState(null, '', url);
                } catch (e) { }
            }

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-tab]');
                if (!btn) return;
                e.preventDefault();
                show(btn.dataset.tab);
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // ---------- photo preview ----------
            const file = document.getElementById('pfPhoto');
            const preview = document.getElementById('pfPreview');
            const remove = document.getElementById('pfRemove');

            if (file && preview) {
                file.addEventListener('change', function () {
                    const f = file.files && file.files[0];
                    if (!f) return;

                    let img = preview.querySelector('img');
                    if (!img) {
                        img = document.createElement('img');
                        preview.prepend(img);
                    }
                    img.src = URL.createObjectURL(f);
                    if (remove) remove.checked = false;
                });
            }

            if (remove && preview) {
                remove.addEventListener('change', function () {
                    preview.classList.toggle('is-removed', remove.checked);
                });
            }

            // ---------- show / hide password ----------
            document.querySelectorAll('.pf-eye').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const input = btn.parentElement.querySelector('input');
                    const showIt = input.type === 'password';
                    input.type = showIt ? 'text' : 'password';
                    btn.querySelector('i').className = showIt ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
                });
            });
        })();
    </script>
}