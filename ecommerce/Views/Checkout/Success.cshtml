@model Pearl_Poetry.ViewModels.Checkout.OrderSuccessViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Order Placed";
    ViewData["ShowChrome"] = true;
}

@functions {
    static string M(decimal v) => "৳ " + v.ToString("N2", CultureInfo.InvariantCulture);
}

<div class="shop-container">
    <div class="ok-box">
        <div class="ok-icon"><i class="fa-solid fa-check"></i></div>

        <h1>Thank you, @Model.FullName!</h1>
        <p>Your order has been placed successfully.</p>

        <div class="ok-order">Order No: <b>@Model.OrderNumber</b></div>

        @if (Model.PaymentNeedsVerification)
        {
            <p>We will verify your bKash payment shortly and then confirm your order.</p>
        }

        <div class="ok-card">
            <h2>Delivery to</h2>
            <p>@Model.FullName &middot; @Model.Phone</p>
            <p>@Model.FullAddress</p>
        </div>

        <div class="ok-card">
            <h2>Payment</h2>
            <p>@Model.PaymentMethodLabel</p>
        </div>

        <div class="ok-card">
            <h2>Items</h2>
            @foreach (var i in Model.Items)
            {
                <p>
                    @i.Quantity &times; @i.Title
                    @if (!string.IsNullOrEmpty(i.VariantLabel))
                    {
                        <span>(@i.VariantLabel)</span>
                    }
                    &mdash; @M(i.Price * i.Quantity)
                </p>
            }
            <p>Subtotal: @M(Model.Subtotal)</p>
            <p>Delivery: @(Model.DeliveryCharge > 0 ? M(Model.DeliveryCharge) : "Free")</p>
            <p><b>Total: @M(Model.Total)</b></p>
        </div>

        <div class="ok-actions">
            <a href="/" class="btn btn-primary">Continue Shopping</a>
        </div>
    </div>
</div>
