@model Pearl_Poetry.ViewModels.Cart.CartViewModel
@using System.Globalization
@{
    ViewData["Title"] = "My Cart";
    ViewData["ShowChrome"] = true;
}

@functions {
    static string M(decimal v) => "৳ " + v.ToString("N2", CultureInfo.InvariantCulture);
}

<div class="shop-container">

    <nav class="breadcrumb">
        <a href="/">Home</a><span>/</span><span>Cart</span>
    </nav>

    <h1 class="shop-title">Shopping Cart <small>(<span id="cpCount">@Model.ItemCount</span> items)</small></h1>

    @if (Model.IsEmpty)
    {
        <div class="empty-state">
            <i class="fa-solid fa-cart-shopping"></i>
            <h2>Your cart is empty</h2>
            <p>Looks like you haven't added anything yet.</p>
            <a href="/" class="btn btn-primary">Continue Shopping</a>
        </div>
    }
    else
    {
        <div class="cp-layout">

            <div class="cp-list" id="cpList">
                @foreach (var item in Model.Items)
                {
                    <div class="cp-row @(item.IsAvailable ? "" : "has-problem")" data-item="@item.ItemId">

                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="cp-img">
                            <img src="@item.ImagePath" alt="@item.Title"
                                 onerror="this.onerror=null;this.src='/images/categories/fashion.jpg';">
                        </a>

                        <div class="cp-info">
                            <h3><a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">@item.Title</a></h3>

                            @* only rendered when the variant really has a color and/or size *@
                            @if (!string.IsNullOrEmpty(item.VariantLabel))
                            {
                                <div class="cp-variant">@item.VariantLabel</div>
                            }

                            <div class="cp-unit">
                                @if (item.OriginalPrice.HasValue)
                                {
                                    <s>@M(item.OriginalPrice.Value)</s>
                                }
                                @M(item.UnitPrice)
                            </div>

                            @if (item.Problem != null)
                            {
                                <div class="cp-problem">@item.Problem</div>
                            }
                        </div>

                        <div class="cp-qty">
                            <div class="qty sm">
                                <button type="button" data-qty="-1" aria-label="Decrease">&minus;</button>
                                <input type="number" value="@item.Quantity" min="1" inputmode="numeric" aria-label="Quantity">
                                <button type="button" data-qty="1" aria-label="Increase">+</button>
                            </div>
                        </div>

                        <div class="cp-total" data-line-total>@M(item.LineTotal)</div>

                        <button type="button" class="cp-remove" data-remove aria-label="Remove">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                }
            </div>

            <aside class="summary">
                <h2>Order Summary</h2>

                <div class="summary-line">
                    <span>Subtotal</span>
                    <span id="cpSubtotal">@M(Model.Subtotal)</span>
                </div>
                <div class="summary-line muted">
                    <span>Delivery</span>
                    <span>Calculated at checkout</span>
                </div>
                <div class="summary-line total">
                    <span>Total</span>
                    <span id="cpTotal">@M(Model.Subtotal)</span>
                </div>

                <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-block">Proceed to Checkout</a>
                <a href="/" class="link-back">&larr; Continue shopping</a>
            </aside>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}
